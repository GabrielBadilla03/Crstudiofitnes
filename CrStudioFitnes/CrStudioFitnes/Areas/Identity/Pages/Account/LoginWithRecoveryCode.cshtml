@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Verificación con código de recuperación";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-3">
                        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                        <p class="text-muted mb-0">
                            Ingresá tu código de recuperación para continuar.
                        </p>
                    </div>

                    <div class="alert alert-info" style="font-size:.95rem;">
                        Usar un código de recuperación no quedará recordado en este dispositivo
                        hasta que iniciés sesión con el código de tu app autenticadora o desactivés el 2FA
                        y vuelvas a iniciar sesión.
                    </div>

                    <form method="post" class="mt-3" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.RecoveryCode"
                                   class="form-control"
                                   autocomplete="off"
                                   placeholder="Código de recuperación" />
                            <label asp-for="Input.RecoveryCode">Código de recuperación</label>
                            <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-lg">
                            Ingresar
                        </button>

                        <div class="mt-3 text-center" style="font-size:.95rem;">
                            <a asp-page="./Login" class="text-decoration-none">
                                Volver al inicio de sesión
                            </a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
