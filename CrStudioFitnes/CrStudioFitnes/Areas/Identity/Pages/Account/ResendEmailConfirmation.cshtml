@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Reenviar confirmación";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-3">
                        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                        <p class="text-muted mb-0">
                            Ingresá tu correo para recibir nuevamente el enlace de confirmación.
                        </p>
                    </div>

                    <form method="post" class="mt-3" novalidate>
                        <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email"
                                   class="form-control"
                                   aria-required="true"
                                   placeholder="name@example.com" />
                            <label asp-for="Input.Email">Correo</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-lg">
                            Reenviar confirmación
                        </button>

                        <div class="mt-3 text-center" style="font-size:.95rem;">
                            <a asp-page="./Login" class="text-decoration-none">
                                Volver a iniciar sesión
                            </a>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
