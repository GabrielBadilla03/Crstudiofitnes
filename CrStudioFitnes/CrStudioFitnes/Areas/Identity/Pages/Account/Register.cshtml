@page
@model RegisterModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center">
                        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                        <p class="text-muted mb-4">Complete sus datos para registrarse.</p>
                    </div>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="row g-3">
                            <!-- Columna izquierda: Datos personales -->
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Nombre" class="form-control" placeholder="Nombre" />
                                    <label asp-for="Input.Nombre">Nombre</label>
                                    <span asp-validation-for="Input.Nombre" class="text-danger"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Apellidos" class="form-control" placeholder="Apellidos" />
                                    <label asp-for="Input.Apellidos">Apellidos</label>
                                    <span asp-validation-for="Input.Apellidos" class="text-danger"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.TelefonoPersonal" class="form-control" placeholder="Teléfono personal" />
                                    <label asp-for="Input.TelefonoPersonal">Teléfono personal</label>
                                    <span asp-validation-for="Input.TelefonoPersonal" class="text-danger"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.TelefonoEmergencia" class="form-control" placeholder="Teléfono de emergencia" />
                                    <label asp-for="Input.TelefonoEmergencia">Teléfono de emergencia</label>
                                    <span asp-validation-for="Input.TelefonoEmergencia" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Columna derecha: Datos de cuenta -->
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Cedula" class="form-control" placeholder="Cédula" />
                                    <label asp-for="Input.Cedula">Cédula</label>
                                    <span asp-validation-for="Input.Cedula" class="text-danger"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                                    <label asp-for="Input.Email">Email</label>
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Contraseña" />
                                    <label asp-for="Input.Password">Contraseña</label>
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirmar contraseña" />
                                    <label asp-for="Input.ConfirmPassword">Confirmar contraseña</label>
                                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Columna completa -->
                            <div class="col-12">
                                <div class="form-floating mb-3">
                                    <textarea asp-for="Input.LesionOperacion" class="form-control" placeholder="Lesión u operación" style="height: 100px;"></textarea>
                                    <label asp-for="Input.LesionOperacion">Lesión u operación (opcional)</label>
                                    <span asp-validation-for="Input.LesionOperacion" class="text-danger"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <textarea asp-for="Input.Patologia" class="form-control" placeholder="Patología" style="height: 100px;"></textarea>
                                    <label asp-for="Input.Patologia">Patología (opcional)</label>
                                    <span asp-validation-for="Input.Patologia" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Botones -->
                            <div class="col-12 mt-2">
                                <div class="row g-2">
                                    <div class="col-12 col-md-6">
                                        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl"
                                           class="btn btn-outline-secondary w-100 btn-lg">
                                            Ya tengo cuenta
                                        </a>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <button id="registerSubmit" type="submit" class="btn btn-primary w-100 btn-lg">
                                            Registrar
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
