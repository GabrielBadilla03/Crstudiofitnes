@page
@model LogoutModel
@{
    ViewData["Title"] = "Cerrar sesión";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-3">
                        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                        <p class="text-muted mb-0">
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <text>¿Querés cerrar sesión ahora?</text>
                            }
                            else
                            {
                                <text>Tu sesión ya fue cerrada.</text>
                            }
                        </p>
                    </div>

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <div class="alert alert-warning" style="font-size:.95rem;">
                            Al cerrar sesión tendrás que volver a iniciar sesión para acceder a tu cuenta.
                        </div>

                        <form class="mt-3"
                              asp-area="Identity"
                              asp-page="/Account/Logout"
                              asp-route-returnUrl="@Url.Page("/", new { area = "" })"
                              method="post">
                            <div class="row g-2">
                                <div class="col-12 col-md-6">
                                    <button type="submit" class="btn btn-danger w-100 btn-lg">
                                        Cerrar sesión
                                    </button>
                                </div>
                                <div class="col-12 col-md-6">
                                    <a asp-page="/Index" asp-area="" class="btn btn-outline-secondary w-100 btn-lg">
                                        Cancelar
                                    </a>
                                </div>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-success mb-0">
                            ✅ Cerraste sesión correctamente.
                        </div>

                        <div class="d-grid gap-2 mt-3">
                            <a asp-page="./Login" class="btn btn-primary btn-lg">
                                Ir a iniciar sesión
                            </a>
                            <a asp-page="/Index" asp-area="" class="btn btn-outline-secondary">
                                Volver al inicio
                            </a>
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>
