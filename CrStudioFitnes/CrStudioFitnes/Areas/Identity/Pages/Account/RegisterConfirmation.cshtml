@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmación de registro";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-3">
                        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                        <p class="text-muted mb-0">
                            Tu cuenta fue creada correctamente.
                        </p>
                    </div>

                    @if (Model.DisplayConfirmAccountLink)
                    {
                        <div class="alert alert-warning">
                            <div class="fw-semibold mb-1">⚠️ Confirmación manual (modo desarrollo)</div>
                            <div class="text-muted" style="font-size:.95rem;">
                                Esta aplicación todavía no tiene configurado un servicio real de envío de correos.
                                Normalmente, este enlace se enviaría a tu email.
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-3">
                            <a id="confirm-link" class="btn btn-primary"
                               href="@Model.EmailConfirmationUrl">
                                Confirmar mi cuenta
                            </a>

                            <a asp-page="./Login" class="btn btn-outline-secondary">
                                Ir a iniciar sesión
                            </a>
                        </div>

                        <div class="text-muted mt-3" style="font-size:.9rem;">
                            Si vas a habilitar correos reales, revisá la documentación de configuración del sender.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success">
                            <div class="fw-semibold mb-1">✅ Revisá tu correo</div>
                            <div class="text-muted" style="font-size:.95rem;">
                                Te enviamos un enlace para confirmar tu cuenta.
                                Abrí tu bandeja de entrada (y spam) y completá la confirmación.
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-3">
                            <a asp-page="./Login" class="btn btn-primary">
                                Ir a iniciar sesión
                            </a>

                            <a asp-page="./ResendEmailConfirmation" class="btn btn-outline-secondary">
                                Reenviar confirmación
                            </a>
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>
