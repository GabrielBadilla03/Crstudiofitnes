@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Contraseña actualizada";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-3">
                        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                        <p class="text-muted mb-0">
                            Tu contraseña fue restablecida correctamente.
                        </p>
                    </div>

                    <div class="alert alert-success">
                        ✅ Listo. Ya podés iniciar sesión con tu nueva contraseña.
                    </div>

                    <div class="d-grid gap-2 mt-3">
                        <a asp-page="./Login" class="btn btn-primary btn-lg">
                            Ir a iniciar sesión
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
