@model CrStudioFitnes.Models.Cuerpo

@{
    ViewData["Title"] = "Crear Cuerpo";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center">
                        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                        <p class="text-muted mb-4">Complete los datos para registrar un nuevo cuerpo.</p>
                    </div>

                    <form asp-action="Create" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="Nombre" class="form-control" placeholder="Nombre" />
                                    <label asp-for="Nombre">Nombre</label>
                                </div>
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="Detalle"
                                              class="form-control"
                                              placeholder="Detalle"
                                              style="height: 130px"></textarea>
                                    <label asp-for="Detalle">Detalle</label>
                                </div>
                                <span asp-validation-for="Detalle" class="text-danger"></span>
                            </div>

                            <div class="col-12 d-flex justify-content-between mt-2">
                                <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                                <button type="submit" class="btn btn-primary">Crear</button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
