@model CrStudioFitnes.Models.Historial

@{
    ViewData["Title"] = "Detalle de historial";

    var u = Model.Usuario;
    var nombre = u != null ? $"{u.Nombre} {u.Apellidos}".Trim() : "";
    if (string.IsNullOrWhiteSpace(nombre)) nombre = "Usuario";

    var cedula = u?.Cedula ?? "";
    var email = u?.Email ?? "";

    var pesajes = (Model.Pesajes ?? new List<CrStudioFitnes.Models.Pesaje>())
        .OrderByDescending(p => p.Fecha)
        .ToList();

    var cuerpos = (ViewBag.Cuerpos as List<CrStudioFitnes.Models.Cuerpo>)
              ?? new List<CrStudioFitnes.Models.Cuerpo>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-3">
                        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                        <p class="text-muted mb-0">
                            @nombre
                            @if (!string.IsNullOrWhiteSpace(cedula))
                            {
                                <span> · @cedula</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(email))
                            {
                                <span> · @email</span>
                            }
                        </p>
                    </div>

                    <!-- Resumen del historial -->
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="cr-card-paquete h-100" style="cursor:default;">
                                <div class="cr-card-paquete-body">
                                    <div class="cr-card-title">Fechas</div>
                                    <div class="cr-card-subtitle">
                                        <div><span class="text-muted">Inicio:</span> <span class="fw-semibold">@Model.FechaInicio.ToString("dd/MM/yyyy")</span></div>
                                        <div><span class="text-muted">Fin:</span> <span class="fw-semibold">@((Model.FechaFin.HasValue) ? Model.FechaFin.Value.ToString("dd/MM/yyyy") : "—")</span></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="cr-card-paquete h-100" style="cursor:default;">
                                <div class="cr-card-paquete-body">
                                    <div class="cr-card-title">Datos físicos</div>
                                    <div class="cr-card-subtitle">
                                        <div><span class="text-muted">Estatura:</span> <span class="fw-semibold">@((Model.Estatura.HasValue) ? Model.Estatura.Value.ToString("N2") : "—")</span></div>
                                        <div><span class="text-muted">Peso inicial:</span> <span class="fw-semibold">@((Model.Peso.HasValue) ? Model.Peso.Value.ToString("N2") : "—")</span></div>
                                        <div><span class="text-muted">Edad:</span> <span class="fw-semibold">@((Model.Edad.HasValue) ? Model.Edad.Value.ToString() : "—")</span></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="cr-card-paquete" style="cursor:default;">
                                <div class="cr-card-paquete-body">
                                    <div class="cr-card-title">Información adicional</div>
                                    <div class="cr-card-subtitle">
                                        <div><span class="text-muted">Estado:</span> <span class="fw-semibold">@(!string.IsNullOrWhiteSpace(Model.Estado) ? Model.Estado : "—")</span></div>
                                        <div><span class="text-muted">Actividad:</span> <span class="fw-semibold">@(!string.IsNullOrWhiteSpace(Model.Actividad) ? Model.Actividad : "—")</span></div>
                                        <div>
                                            <span class="text-muted">Frecuencia:</span>
                                            <span class="fw-semibold">@((Model.Frecuencia?.ToString()) ?? "—")</span>
                                        </div>
                                        <div><span class="text-muted">Objetivo:</span> <span class="fw-semibold">@(!string.IsNullOrWhiteSpace(Model.Objetivo) ? Model.Objetivo : "—")</span></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Pesajes -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-4">
                        <div>
                            <h5 class="mb-0">Pesajes</h5>
                            <div class="text-muted small">
                                Total: <span class="fw-semibold">@pesajes.Count</span>
                            </div>
                        </div>

                        <button type="button"
                                class="btn btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#modalAgregarPesaje">
                            Agregar pesaje
                        </button>
                    </div>

                    <hr class="my-3" />

                    @if (pesajes.Count == 0)
                    {
                        <div class="alert alert-info mb-0">
                            Este historial aún no tiene pesajes registrados.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table cr-table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Fecha</th>
                                        <th class="text-end">Peso (kg)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in pesajes)
                                    {
                                        <tr class="pesaje-row"
                                            style="cursor:pointer;"
                                            data-idpesaje="@p.IdPesaje"
                                            data-fecha="@p.Fecha.ToString("dd/MM/yyyy")"
                                            data-peso="@p.Peso.ToString("N2")">
                                            <td>@p.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td class="text-end">@p.Peso.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" asp-route-idUsuario="@Model.IdUsuario" class="btn btn-outline-secondary">
                            Volver
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<!-- MODAL: Agregar Pesaje -->
<div class="modal fade" id="modalAgregarPesaje" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content cr-card">
            <div class="modal-header">
                <h5 class="modal-title">Agregar pesaje</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <form asp-action="AgregarPesaje" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <input type="hidden" name="idHistorial" value="@Model.IdHistorial" />
                    <input type="hidden" name="idUsuario" value="@Model.IdUsuario" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Fecha</label>
                        <input type="date" class="form-control" name="fecha"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold">Peso (kg)</label>
                        <input type="number" class="form-control" name="peso" step="0.01" min="1" max="500" required />
                        <div class="text-muted small mt-1">Ejemplo: 72.50</div>
                    </div>
                </div>

                <div class="modal-footer d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">Guardar</button>
                    <button type="button" class="btn btn-outline-secondary w-100" data-bs-dismiss="modal">Cancelar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="modalPesajeMedidas" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content cr-card">
            <div class="modal-header">
                <h5 class="modal-title">Medidas del pesaje</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <input type="hidden" id="pm_idPesaje" />

                <div class="text-center mb-3">
                    <div class="fw-semibold" id="pm_titulo">Pesaje</div>
                    <div class="text-muted small" id="pm_subtitulo"></div>
                </div>

                <div id="pm_lista">
                    <div class="text-muted small">Cargando...</div>
                </div>

                <hr class="my-3" />

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="fw-semibold">Agregar o actualizar medida</div>
                    <button type="button" class="btn btn-outline-light btn-sm" id="pm_btnToggle">
                        Agregar medida
                    </button>
                </div>

                <div id="pm_formWrap" style="display:none;">
                    <form id="pm_form">
                        @Html.AntiForgeryToken()

                        <div class="row g-2">
                            <div class="col-12 col-md-7">
                                <label class="form-label fw-semibold">Parte del cuerpo</label>
                                <select class="form-select" id="pm_idCuerpo" required>
                                    <option value="">-- Seleccione --</option>
                                    @foreach (var c in cuerpos)
                                    {
                                        <option value="@c.IdCuerpo">@c.Nombre</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12 col-md-5">
                                <label class="form-label fw-semibold">Medida (cm)</label>
                                <input type="number" class="form-control" id="pm_medida" step="0.01" min="0" max="500" required />
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-primary w-100">Guardar medida</button>
                            <button type="button" class="btn btn-outline-secondary w-100" id="pm_btnCancelar">Cancelar</button>
                        </div>

                        <div class="text-danger small mt-2" id="pm_error" style="display:none;"></div>
                    </form>
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary w-100" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {

            const modalEl = document.getElementById('modalPesajeMedidas');
            const bsModal = new bootstrap.Modal(modalEl);

            const pmIdPesaje = document.getElementById('pm_idPesaje');
            const pmTitulo = document.getElementById('pm_titulo');
            const pmSubtitulo = document.getElementById('pm_subtitulo');
            const pmLista = document.getElementById('pm_lista');

            const btnToggle = document.getElementById('pm_btnToggle');
            const formWrap = document.getElementById('pm_formWrap');
            const btnCancelar = document.getElementById('pm_btnCancelar');
            const form = document.getElementById('pm_form');

            const selCuerpo = document.getElementById('pm_idCuerpo');
            const txtMedida = document.getElementById('pm_medida');
            const errBox = document.getElementById('pm_error');

            function token() {
                const t = document.querySelector('input[name="__RequestVerificationToken"]');
                return t ? t.value : '';
            }

            function showError(msg) {
                errBox.style.display = 'block';
                errBox.textContent = msg || 'Error';
            }

            function clearError() {
                errBox.style.display = 'none';
                errBox.textContent = '';
            }

            async function cargarMedidas(idPesaje) {
                pmLista.innerHTML = '<div class="text-muted small">Cargando...</div>';

                const url = '@Url.Action("PesajeMedidas", "Historial")' + '?idPesaje=' + encodeURIComponent(idPesaje);
                const res = await fetch(url);

                if (!res.ok) {
                    pmLista.innerHTML = '<div class="text-danger small">No se pudo cargar.</div>';
                    return;
                }

                const data = await res.json();
                const items = data.items || [];

                if (items.length === 0) {
                    pmLista.innerHTML = '<div class="alert alert-info mb-0">Este pesaje aún no tiene medidas de cuerpo.</div>';
                    return;
                }

                let html = `
                    <div class="text-muted small mb-2">
                        Tocá una fila para <strong>eliminar</strong> esa medida del pesaje.
                    </div>
                    <div class="table-responsive">
                        <table class="table cr-table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Medida</th>
                                    <th class="text-end">Valor (cm)</th>
                                </tr>
                            </thead>
                            <tbody>`;

                for (const it of items) {
                    html += `
                        <tr class="pm-row"
                            style="cursor:pointer;"
                            data-idcuerpo="${it.idCuerpo}"
                            data-cuerpo="${(it.cuerpo || '').replace(/"/g, '&quot;')}"
                            data-medida="${it.medida}">
                            <td>${it.cuerpo}</td>
                            <td class="text-end">${Number(it.medida).toFixed(2)}</td>
                        </tr>`;
                }

                html += `
                            </tbody>
                        </table>
                    </div>`;

                pmLista.innerHTML = html;
            }

            // Click en fila de pesaje => abrir modal y cargar medidas
            document.querySelectorAll('.pesaje-row').forEach(row => {
                row.addEventListener('click', async () => {
                    const idPesaje = row.getAttribute('data-idpesaje');
                    const fecha = row.getAttribute('data-fecha') || '';
                    const peso = row.getAttribute('data-peso') || '';

                    pmIdPesaje.value = idPesaje;
                    pmTitulo.textContent = `Pesaje del ${fecha}`;
                    pmSubtitulo.textContent = `Peso: ${peso} kg`;

                    // reset form
                    formWrap.style.display = 'none';
                    selCuerpo.value = '';
                    txtMedida.value = '';
                    clearError();

                    bsModal.show();
                    await cargarMedidas(idPesaje);
                });
            });

            btnToggle.addEventListener('click', () => {
                formWrap.style.display = (formWrap.style.display === 'none') ? 'block' : 'none';
                clearError();
            });

            btnCancelar.addEventListener('click', () => {
                formWrap.style.display = 'none';
                selCuerpo.value = '';
                txtMedida.value = '';
                clearError();
            });

            // Guardar medida (AJAX)
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                clearError();

                const idPesaje = pmIdPesaje.value;
                const idCuerpo = selCuerpo.value;
                const medida = txtMedida.value;

                if (!idPesaje || !idCuerpo || medida === '') {
                    showError('Complete cuerpo y medida.');
                    return;
                }

                const fd = new FormData();
                fd.append('idPesaje', idPesaje);
                fd.append('idCuerpo', idCuerpo);
                fd.append('medida', medida);
                fd.append('__RequestVerificationToken', token());

                const res = await fetch('@Url.Action("GuardarPesajeCuerpo", "Historial")', {
                    method: 'POST',
                    body: fd
                });

                if (!res.ok) {
                    let msg = 'No se pudo guardar.';
                    try {
                        const j = await res.json();
                        msg = j.message || msg;
                    } catch { }
                    showError(msg);
                    return;
                }

                await cargarMedidas(idPesaje);

                formWrap.style.display = 'none';
                selCuerpo.value = '';
                txtMedida.value = '';
            });

            // ✅ Click en una medida del listado => eliminar PesajeCuerpo (IdPesaje + IdCuerpo)
            pmLista.addEventListener('click', async (e) => {
                const tr = e.target.closest('tr.pm-row[data-idcuerpo]');
                if (!tr) return;

                const idPesaje = pmIdPesaje.value;
                const idCuerpo = tr.getAttribute('data-idcuerpo');
                const cuerpo = tr.getAttribute('data-cuerpo') || 'Medida';
                const medida = tr.getAttribute('data-medida') || '';

                if (!idPesaje || !idCuerpo) return;

                const ok = confirm(`¿Eliminar "${cuerpo}" (${Number(medida).toFixed(2)} cm) de este pesaje?`);
                if (!ok) return;

                clearError();

                const fd = new FormData();
                fd.append('idPesaje', idPesaje);
                fd.append('idCuerpo', idCuerpo);
                fd.append('__RequestVerificationToken', token());

                const res = await fetch('@Url.Action("EliminarPesajeCuerpo", "Historial")', {
                    method: 'POST',
                    body: fd
                });

                if (!res.ok) {
                    let msg = 'No se pudo eliminar.';
                    try {
                        const j = await res.json();
                        msg = j.message || msg;
                    } catch { }
                    showError(msg);
                    return;
                }

                await cargarMedidas(idPesaje);

                // opcional: cerrar form si estaba abierto
                formWrap.style.display = 'none';
                selCuerpo.value = '';
                txtMedida.value = '';
            });

        });
    </script>
}

