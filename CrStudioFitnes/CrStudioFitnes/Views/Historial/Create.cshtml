@model CrStudioFitnes.Models.Historial

@{
    ViewData["Title"] = "Crear Historial";

    var selectedText = (ViewBag.SelectedUserText as string) ?? "";
    var usuarioDisplay = string.IsNullOrWhiteSpace(selectedText) ? "Usuario" : selectedText;

    var idUsuario = (Model.IdUsuario ?? "").Trim();
    var hasUser = !string.IsNullOrWhiteSpace(idUsuario);
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center">
                        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                        <p class="text-muted mb-4">
                            Complete los datos del historial para el usuario seleccionado.
                        </p>
                    </div>

                    @if (!hasUser)
                    {
                        <div class="alert alert-warning">
                            No se recibió el usuario. Entrá a esta pantalla desde el botón <strong>Crear nuevo</strong> del listado de historiales.
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                        </div>
                    }
                    else
                    {
                        <form asp-action="Create" method="post" novalidate>
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <!-- ✅ mantener IdUsuario para el POST -->
                            <input type="hidden" asp-for="IdUsuario" />

                            <div class="row g-3 mt-1">
                                <!-- COLUMNA IZQUIERDA -->
                                <div class="col-md-6">

                                    <!-- Usuario (solo lectura) -->
                                    <div class="form-floating">
                                        <input class="form-control"
                                               value="@usuarioDisplay"
                                               readonly
                                               placeholder="Usuario" />
                                        <label>Usuario</label>
                                    </div>

                                    <!-- Fecha inicio -->
                                    <div class="form-floating mt-3">
                                        <input asp-for="FechaInicio"
                                               class="form-control"
                                               type="date"
                                               asp-format="{0:yyyy-MM-dd}" />
                                        <label asp-for="FechaInicio">Fecha inicio</label>
                                        <span asp-validation-for="FechaInicio" class="text-danger"></span>
                                    </div>

                                    <!-- Fecha fin -->
                                    <div class="form-floating mt-3">
                                        <input asp-for="FechaFin"
                                               class="form-control"
                                               type="date"
                                               asp-format="{0:yyyy-MM-dd}" />
                                        <label asp-for="FechaFin">Fecha fin (opcional)</label>
                                        <span asp-validation-for="FechaFin" class="text-danger"></span>
                                    </div>

                                    <!-- Edad -->
                                    <div class="form-floating mt-3">
                                        <input asp-for="Edad"
                                               class="form-control"
                                               type="number"
                                               min="1"
                                               max="120"
                                               placeholder="Edad" />
                                        <label asp-for="Edad">Edad (opcional)</label>
                                        <span asp-validation-for="Edad" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- COLUMNA DERECHA -->
                                <div class="col-md-6">

                                    <div class="form-floating">
                                        <input asp-for="Estatura"
                                               class="form-control"
                                               type="number"
                                               step="0.01"
                                               min="50"
                                               max="300"
                                               placeholder="Estatura" />
                                        <label asp-for="Estatura">Estatura (cm) (opcional)</label>
                                        <span asp-validation-for="Estatura" class="text-danger"></span>
                                    </div>

                                    <div class="form-floating mt-3">
                                        <input asp-for="Peso"
                                               class="form-control"
                                               type="number"
                                               step="0.01"
                                               min="1"
                                               max="500"
                                               placeholder="Peso" />
                                        <label asp-for="Peso">Peso (kg) (opcional)</label>
                                        <span asp-validation-for="Peso" class="text-danger"></span>
                                    </div>

                                    <div class="form-floating mt-3">
                                        <input asp-for="Estado" class="form-control" placeholder="Estado" />
                                        <label asp-for="Estado">Estado (opcional)</label>
                                        <span asp-validation-for="Estado" class="text-danger"></span>
                                    </div>

                                    <div class="form-floating mt-3">
                                        <input asp-for="Actividad" class="form-control" placeholder="Actividad" />
                                        <label asp-for="Actividad">Actividad (opcional)</label>
                                        <span asp-validation-for="Actividad" class="text-danger"></span>
                                    </div>

                                    <div class="form-floating mt-3">
                                        <select asp-for="Frecuencia"
                                                class="form-select"
                                                asp-items="ViewBag.Frecuencias">
                                            <option value="">-- Seleccione --</option>
                                        </select>
                                        <label asp-for="Frecuencia">Frecuencia (plan)</label>
                                        <span asp-validation-for="Frecuencia" class="text-danger"></span>
                                    </div>

                                    <div class="form-floating mt-3">
                                        <input asp-for="Objetivo" class="form-control" placeholder="Objetivo" />
                                        <label asp-for="Objetivo">Objetivo (opcional)</label>
                                        <span asp-validation-for="Objetivo" class="text-danger"></span>
                                    </div>
                                </div>

                                <!-- Botones -->
                                <div class="col-12 d-flex justify-content-between mt-2">
                                    <a asp-action="Index"
                                       asp-route-idUsuario="@idUsuario"
                                       class="btn btn-outline-secondary">
                                        Volver a la lista
                                    </a>

                                    <button type="submit" class="btn btn-primary">Crear</button>
                                </div>
                            </div>
                        </form>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
