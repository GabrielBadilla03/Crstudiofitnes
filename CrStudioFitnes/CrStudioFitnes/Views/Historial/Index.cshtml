@model IEnumerable<CrStudioFitnes.Models.Historial>

@{
    ViewData["Title"] = "Historiales";

    var currentIdUsuario = ViewData["CurrentIdUsuario"] as string ?? "";
    var hasUser = !string.IsNullOrWhiteSpace(currentIdUsuario);
    bool canManage = ViewData["CanManageHistorial"] is bool value && value;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">

                    <div class="d-flex flex-wrap align-items-center mb-3">
                        <div class="text-center flex-grow-1 w-100">
                            <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                            <p class="text-muted mb-0">
                                @if (hasUser)
                                {
                                    <text>Historiales del usuario seleccionado.</text>
                                }
                                else
                                {
                                    <text>No se recibió un usuario.</text>
                                }
                            </p>
                        </div>

                        @if (hasUser && canManage)
                        {
                            <div class="mt-3 mt-md-0 text-center text-md-end w-100 w-md-auto ms-md-auto">
                                <a asp-action="Create"
                                   asp-route-idUsuario="@currentIdUsuario"
                                   class="btn btn-primary">
                                    Crear nuevo
                                </a>
                            </div>
                        }
                    </div>

                    @if (hasUser && Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table cr-table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Inicio</th>
                                        <th>Fin</th>
                                        <th>Frecuencia</th>
                                        <th class="text-end">Estatura</th>
                                        <th class="text-end">Peso</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        var freqText = item.Frecuencia?.ToString() ?? "—";

                                        var titulo = $"Historial {item.FechaInicio:dd/MM/yyyy}"
                                            + (item.FechaFin.HasValue
                                                ? $" - {item.FechaFin:dd/MM/yyyy}"
                                                : "")
                                            + $" · {freqText}";

                                        <tr class="hist-row"
                                            style="cursor:pointer;"
                                            data-id="@item.IdHistorial"
                                            data-nombre="@titulo">
                                            <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                                            <td>@(item.FechaFin.HasValue ? item.FechaFin.Value.ToString("dd/MM/yyyy") : "—")</td>
                                            <td>@freqText</td>
                                            <td class="text-end">@(item.Estatura.HasValue ? item.Estatura.Value.ToString("N2") : "—")</td>
                                            <td class="text-end">@(item.Peso.HasValue ? item.Peso.Value.ToString("N2") : "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (hasUser)
                    {
                        <div class="alert alert-info mb-0">
                            Este usuario no tiene historiales registrados.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">
                            Seleccioná un usuario para consultar su historial.
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade"
     id="historialModal"
     tabindex="-1"
     aria-labelledby="historialModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered cr-modal-narrow">
        <div class="modal-content cr-card">
            <div class="modal-header">
                <h5 class="modal-title" id="historialModalLabel">
                    Historial
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <p class="mb-2 text-center">
                    <strong id="modalHistorialNombre"></strong>
                </p>
            </div>

            <div class="modal-footer d-flex flex-column flex-sm-row gap-2">
                <a id="modalDetailsLink"
                   class="btn btn-outline-light w-100">
                    Detalles
                </a>

                @if (canManage)
                {
                    <a id="modalDeleteLink"
                       class="btn btn-outline-danger w-100">
                        Borrar
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const modalElement = document.getElementById('historialModal');
            const modalNombre = document.getElementById('modalHistorialNombre');
            const detailsLink = document.getElementById('modalDetailsLink');
            const deleteLink = document.getElementById('modalDeleteLink');

            const detailsBaseUrl = '@Url.Action("Details", "Historial")';
            const deleteBaseUrl = '@Url.Action("Delete", "Historial")';

            if (!modalElement) return;

            const bsModal = new bootstrap.Modal(modalElement);

            document.querySelectorAll('tr.hist-row[data-id]').forEach(row => {
                row.addEventListener('click', () => {
                    const id = row.getAttribute('data-id');
                    const nombre = row.getAttribute('data-nombre') || 'Historial';

                    modalNombre.textContent = nombre;
                    detailsLink.href = detailsBaseUrl + '/' + id;

                    if (deleteLink) {
                        deleteLink.href = deleteBaseUrl + '/' + id;
                    }

                    bsModal.show();
                });
            });
        });
    </script>
}
