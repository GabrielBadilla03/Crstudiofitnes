@model CrStudioFitnes.Models.BloqueoHorario
@using System.Globalization

@{
    ViewData["Title"] = "Desactivar bloqueo";

    string fechaTxt =
        Model.Fecha.HasValue
            ? Model.Fecha.Value.ToString(
                "dd/MM/yyyy",
                CultureInfo.GetCultureInfo("es-CR"))
            : "—";

    var horaTxt = "—";

    if (Model.HoraReserva != null)
    {
        horaTxt =
            !string.IsNullOrWhiteSpace(Model.HoraReserva.Etiqueta)
                ? Model.HoraReserva.Etiqueta!
                : Model.HoraReserva.Hora.ToString(@"hh\:mm");
    }

    var motivoTxt =
        string.IsNullOrWhiteSpace(Model.Motivo)
            ? "—"
            : Model.Motivo;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm cr-card border-danger">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center">
                        <h1 class="h3 mb-3 text-danger">
                            @ViewData["Title"]
                        </h1>

                        <p class="text-muted mb-4">
                            El bloqueo dejará de aplicarse, pero el registro se conservará.
                        </p>
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4 fw-bold">Fecha:</dt>
                        <dd class="col-sm-8">@fechaTxt</dd>

                        <dt class="col-sm-4 fw-bold">Hora:</dt>
                        <dd class="col-sm-8">@horaTxt</dd>

                        <dt class="col-sm-4 fw-bold">Motivo:</dt>
                        <dd class="col-sm-8">@motivoTxt</dd>
                    </dl>

                    <form id="deleteForm"
                          asp-action="Delete"
                          method="post"
                          class="d-flex justify-content-between mt-4">
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="IdBloqueoHorario" />

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>

                        <button type="button"
                                class="btn btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#confirmDeleteModal">
                            Desactivar
                        </button>
                    </form>

                    <div class="modal fade"
                         id="confirmDeleteModal"
                         tabindex="-1"
                         aria-labelledby="confirmDeleteLabel"
                         aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered cr-modal-narrow">
                            <div class="modal-content cr-card border-0">
                                <div class="modal-header bg-danger text-white">
                                    <h5 class="modal-title"
                                        id="confirmDeleteLabel">
                                        Confirmar desactivación
                                    </h5>

                                    <button type="button"
                                            class="btn-close btn-close-white"
                                            data-bs-dismiss="modal"
                                            aria-label="Cerrar"></button>
                                </div>

                                <div class="modal-body">
                                    ¿Seguro que desea desactivar este bloqueo?

                                    <div class="small text-muted mt-2">
                                        @fechaTxt · @horaTxt
                                    </div>
                                </div>

                                <div class="modal-footer">
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            data-bs-dismiss="modal">
                                        No, cancelar
                                    </button>

                                    <button type="button"
                                            id="confirmDeleteBtn"
                                            class="btn btn-danger">
                                        Sí, desactivar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const confirmBtn =
                document.getElementById('confirmDeleteBtn');

            const form =
                document.getElementById('deleteForm');

            confirmBtn?.addEventListener('click', function () {
                form?.submit();
            });
        });
    </script>
}
