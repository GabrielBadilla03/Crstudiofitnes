@model IEnumerable<CrStudioFitnes.Models.BloqueoHorario>
@using System.Globalization

@{
    ViewData["Title"] = "Bloqueos de horario";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">

                    <!-- Encabezado -->
                    <div class="d-flex flex-wrap align-items-center mb-3">
                        <div class="text-center flex-grow-1 w-100">
                            <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                            <p class="text-muted mb-0">Listado de bloqueos registrados.</p>
                        </div>

                        <div class="mt-3 mt-md-0 text-center text-md-end w-100 w-md-auto ms-md-auto">
                            <a asp-action="Create" class="btn btn-primary">
                                Crear bloqueo
                            </a>
                        </div>
                    </div>

                    @if (Model == null || !Model.Any())
                    {
                        <div class="alert alert-info mb-0">
                            No hay bloqueos registrados.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-hover align-middle cr-table cr-table-lg">
                                <thead>
                                    <tr>
                                        <th style="width:180px;">Fecha</th>
                                        <th style="width:150px;">Estado</th>
                                        <th style="width:160px;">Hora</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        var fechaTxt = item.Fecha.HasValue
                                        ? item.Fecha.Value.ToString("dd/MM/yyyy", CultureInfo.GetCultureInfo("es-CR"))
                                        : "—";

                                        var horaTxt = (item.HoraReserva != null)
                                        ? item.HoraReserva.Hora.ToString(@"hh\:mm")
                                        : "—";

                                        var estadoTxt = item.Activo ? "Activo" : "Inactivo";

                                        <tr class="cr-row-click"
                                            style="cursor:pointer;"
                                            data-id="@item.IdBloqueoHorario"
                                            data-fecha="@fechaTxt"
                                            data-hora="@horaTxt"
                                            data-estado="@estadoTxt">
                                            <td>@fechaTxt</td>

                                            <td>
                                                @if (item.Activo)
                                                {
                                                    <span class="badge bg-success">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactivo</span>
                                                }
                                            </td>

                                            <td>@horaTxt</td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>

                        <div class="text-muted mt-2" style="font-size:.9rem;">
                            Tip: tocá/clickeá una fila para ver acciones del bloqueo.
                        </div>
                    }

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-controller="Reservas" asp-action="Index" class="btn btn-outline-secondary">
                            Volver
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<!-- ✅ MODAL DE ACCIONES (igual estilo al de Paquetes) -->
<div class="modal fade" id="bloqueoModal" tabindex="-1" aria-labelledby="bloqueoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered cr-modal-narrow">
        <div class="modal-content cr-card">
            <div class="modal-header">
                <h5 class="modal-title" id="bloqueoModalLabel">Acciones del bloqueo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <div class="text-center mb-2">
                    <strong id="modalBloqueoTitulo"></strong>
                </div>

                <div class="small text-muted">
                    <div><span class="fw-semibold">Fecha:</span> <span id="modalBloqueoFecha"></span></div>
                    <div><span class="fw-semibold">Hora:</span> <span id="modalBloqueoHora"></span></div>
                    <div><span class="fw-semibold">Estado:</span> <span id="modalBloqueoEstado"></span></div>
                    <div class="mt-2"><span class="fw-semibold">Motivo:</span></div>
                    <div id="modalBloqueoMotivo" style="white-space:pre-wrap;"></div>
                </div>
            </div>

            <div class="modal-footer d-flex flex-column flex-sm-row gap-2">
                <a id="modalEditLink" class="btn btn-primary w-100">Editar</a>
                <a id="modalDeleteLink" class="btn btn-outline-danger w-100">Borrar</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const rows = document.querySelectorAll('.cr-row-click');
            const modalElement = document.getElementById('bloqueoModal');

            const titulo = document.getElementById('modalBloqueoTitulo');
            const fecha = document.getElementById('modalBloqueoFecha');
            const hora = document.getElementById('modalBloqueoHora');
            const estado = document.getElementById('modalBloqueoEstado');
            const motivo = document.getElementById('modalBloqueoMotivo');

            const editLink = document.getElementById('modalEditLink');
            const deleteLink = document.getElementById('modalDeleteLink');

            // Rutas base
            const editBaseUrl = '@Url.Action("Edit", "BloqueoHorarios")';
            const deleteBaseUrl = '@Url.Action("Delete", "BloqueoHorarios")';

            const bsModal = new bootstrap.Modal(modalElement);

            rows.forEach(function (row) {
                row.addEventListener('click', function () {
                    const id = row.getAttribute('data-id');

                    const f = row.getAttribute('data-fecha') || '—';
                    const h = row.getAttribute('data-hora') || '—';
                    const e = row.getAttribute('data-estado') || '—';
                    const m = row.getAttribute('data-motivo') || '—';

                    titulo.textContent = 'Bloqueo #' + id;
                    fecha.textContent = f;
                    hora.textContent = h;
                    estado.textContent = e;
                    motivo.textContent = m;

                    editLink.href = editBaseUrl + '/' + id;
                    deleteLink.href = deleteBaseUrl + '/' + id;

                    bsModal.show();
                });
            });
        });
    </script>
}
