@model CrStudioFitnes.Models.Paquete

@{
    ViewData["Title"] = "Editar Paquete";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">

                    <!-- Encabezado con mismos estilos de colores que el Create -->
                    <div class="text-center">
                        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                        <p class="text-muted mb-4">Modifique los datos del paquete seleccionado.</p>
                    </div>

                    <form asp-action="Edit" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="IdPaquete" />

                        <div class="row g-3">
                            <!-- Columna izquierda -->
                            <div class="col-md-6">

                                <div class="form-floating mb-3">
                                    <input asp-for="Detalle" class="form-control" placeholder="Detalle" />
                                    <label asp-for="Detalle">Nombre del Paquete</label>
                                    <span asp-validation-for="Detalle" class="text-danger"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="Pago"
                                           class="form-control"
                                           asp-format="{0:0}"
                                           placeholder="Monto" />
                                    <label asp-for="Pago">Monto</label>
                                    <span asp-validation-for="Pago" class="text-danger"></span>
                                </div>

                            </div>

                            <!-- Columna derecha -->
                            <div class="col-md-6">

                                <div class="form-floating mb-3">
                                    <select asp-for="CantDias" class="form-select" asp-items="ViewBag.CantDiasList">
                                        <option value="">Seleccione el tipo</option>
                                    </select>
                                    <label asp-for="CantDias">Tipo de Plan</label>
                                    <span asp-validation-for="CantDias" class="text-danger"></span>
                                </div>

                                <div class="form-floating mb-3">
                                    <input asp-for="CantLecciones"
                                           class="form-control"
                                           placeholder="Cantidad de lecciones"
                                           type="number"
                                           min="0"
                                           oninput="if (this.value < 0) this.value = 0;" />
                                    <label asp-for="CantLecciones">Cantidad de Lecciones</label>
                                    <span asp-validation-for="CantLecciones" class="text-danger"></span>
                                </div>

                                <div class="form-check form-switch mb-3" style="margin-left: 15px;">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           asp-for="Activo"
                                           id="activoSwitch"
                                           style="transform: scale(1.5); cursor:pointer;" />
                                    <label class="form-check-label fw-bold ms-2" for="activoSwitch">
                                        @Html.DisplayNameFor(m => m.Activo)
                                    </label>
                                </div>
                            </div>

                            <!-- Botones con mismos estilos de colores -->
                            <div class="col-12 d-flex justify-content-between mt-3">
                                <a asp-action="Index" class="btn btn-outline-secondary">Volver a la lista</a>
                                <button type="submit" class="btn btn-primary">Guardar cambios</button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
