@model CrStudioFitnes.Models.Paquete

@{
    ViewData["Title"] = "Editar Paquete";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center">
                        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                        <p class="text-muted mb-4">
                            Modifique los datos del paquete seleccionado.
                        </p>
                    </div>

                    <form asp-action="Edit" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="IdPaquete" />

                        <div class="row g-3">
                            <div class="col-12">
                                <div class="form-floating">
                                    <input asp-for="Detalle"
                                           class="form-control"
                                           placeholder="Nombre del paquete"
                                           maxlength="200" />
                                    <label asp-for="Detalle">Nombre del paquete</label>
                                    <span asp-validation-for="Detalle" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select asp-for="CantDias"
                                            class="form-select"
                                            asp-items="ViewBag.CantDiasList">
                                        <option value="">Seleccione el tipo</option>
                                    </select>
                                    <label asp-for="CantDias">Tipo de plan</label>
                                    <span asp-validation-for="CantDias" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="CantLecciones"
                                           class="form-control"
                                           type="number"
                                           min="1"
                                           max="1000"
                                           step="1"
                                           placeholder="Cantidad total de lecciones" />
                                    <label asp-for="CantLecciones">Cantidad total de lecciones</label>
                                    <span asp-validation-for="CantLecciones" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Pago"
                                           class="form-control"
                                           type="number"
                                           min="0.01"
                                           max="1000000"
                                           step="0.01"
                                           placeholder="Monto total del paquete" />
                                    <label asp-for="Pago">Monto total del paquete</label>
                                    <span asp-validation-for="Pago" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="CantLeccionesPorUsuario"
                                           class="form-control"
                                           type="number"
                                           min="1"
                                           max="1000"
                                           step="1"
                                           placeholder="Lecciones por usuario" />
                                    <label asp-for="CantLeccionesPorUsuario">Lecciones por usuario</label>
                                    <span asp-validation-for="CantLeccionesPorUsuario" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="PagoPorUsuario"
                                           class="form-control"
                                           type="number"
                                           min="0.01"
                                           max="1000000"
                                           step="0.01"
                                           placeholder="Monto por usuario" />
                                    <label asp-for="PagoPorUsuario">Monto por usuario</label>
                                    <span asp-validation-for="PagoPorUsuario" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6 d-flex align-items-center">
                                <div class="form-check form-switch ms-2">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           asp-for="Activo"
                                           id="activoSwitch"
                                           style="transform: scale(1.5); cursor:pointer;" />
                                    <label class="form-check-label fw-bold ms-2" for="activoSwitch">
                                        @Html.DisplayNameFor(m => m.Activo)
                                    </label>
                                </div>
                            </div>

                            <div class="col-12 d-flex justify-content-between mt-4">
                                <a asp-action="Index" class="btn btn-outline-secondary">
                                    Volver a la lista
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    Guardar cambios
                                </button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
