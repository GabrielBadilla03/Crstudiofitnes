@model CrStudioFitnes.Models.Paquete

@{
    ViewData["Title"] = "Detalles del Paquete";
    bool canManage = ViewData["CanManage"] is bool value && value;
    int gruposActivos = ViewBag.GruposActivos is int g ? g : 0;
    string nombre = !string.IsNullOrWhiteSpace(Model.Detalle)
        ? Model.Detalle
        : "Paquete sin nombre";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                        <p class="text-muted mb-0">@nombre</p>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Tipo</div>
                                <div class="fw-semibold">@(Model.EsGrupal ? "Grupal" : "Individual")</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Cantidad de cupos</div>
                                <div class="fw-semibold">@Model.CantidadUsuarios</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Tipo de plan</div>
                                <div class="fw-semibold">@Model.CantDias</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Grupos activos usando este paquete</div>
                                <div class="fw-semibold">@gruposActivos</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Lecciones totales (referencia)</div>
                                <div class="fw-semibold">@Model.CantLecciones</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Lecciones por cupo (operativo)</div>
                                <div class="fw-semibold">@Model.CantLeccionesPorUsuario</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Monto total (referencia)</div>
                                <div class="fw-semibold">₡@Model.Pago.ToString("N2")</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <div class="text-muted small">Monto por cupo (operativo)</div>
                                <div class="fw-semibold">₡@Model.PagoPorUsuario.ToString("N2")</div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="border rounded p-3">
                                <div class="text-muted small">Estado</div>
                                @if (Model.Activo)
                                {
                                    <span class="badge bg-success mt-1">Visible</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary mt-1">Oculto</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-column flex-sm-row justify-content-between gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Volver a la lista</a>
                        @if (canManage)
                        {
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@Model.IdPaquete" class="btn btn-primary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@Model.IdPaquete" class="btn btn-outline-danger">Ocultar</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
