@using SIGE.Helpers
@model PaginatedList<CrStudioFitnes.Models.Paquete>

@{
    ViewData["Title"] = "Paquetes";
    var currentBuscar = ViewData["CurrentBuscar"] as string ?? "";
    bool currentSoloActivos = ViewData["CurrentSoloActivos"] is bool b ? b : true;
    bool canManage = User.IsInRole("Administrador") || User.IsInRole("Gestor de Pagos");
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-11">
            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                        <div>
                            <h1 class="h3 mb-1">Paquetes</h1>
                            <p class="text-muted mb-0">Los montos y lecciones por usuario son los valores operativos.</p>
                        </div>
                        @if (canManage)
                        {
                            <a asp-action="Create" class="btn btn-primary">Crear paquete</a>
                        }
                    </div>

                    @if (TempData["Ok"] != null)
                    {
                        <div class="alert alert-success">@TempData["Ok"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <form method="get" class="row g-2 mb-4">
                        <div class="col-12 col-md-6">
                            <input class="form-control" name="buscar" value="@currentBuscar" placeholder="Buscar paquete..." />
                        </div>
                        @if (canManage)
                        {
                            <div class="col-12 col-md-3 d-flex align-items-center">
                                <div class="form-check">
                                    <input type="hidden" name="soloActivos" value="false" />
                                    <input class="form-check-input" type="checkbox" id="soloActivos" name="soloActivos" value="true" @(currentSoloActivos ? "checked" : "") />
                                    <label class="form-check-label" for="soloActivos">Solo visibles</label>
                                </div>
                            </div>
                        }
                        <div class="col-12 col-md-3 d-flex gap-2">
                            <button class="btn btn-outline-primary flex-grow-1" type="submit">Filtrar</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                        </div>
                    </form>

                    @if (Model == null || !Model.Any())
                    {
                        <div class="alert alert-info mb-0">No hay paquetes para mostrar.</div>
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var p in Model)
                            {
                                var nombre = string.IsNullOrWhiteSpace(p.Detalle) ? $"Paquete #{p.IdPaquete}" : p.Detalle;
                                <div class="col-12 col-md-6 col-xl-4">
                                    <a asp-action="Details" asp-route-id="@p.IdPaquete" class="text-decoration-none d-block h-100">
                                        <div class="cr-card-paquete h-100">
                                            <div class="cr-card-paquete-body">
                                                <div class="d-flex justify-content-between gap-2 align-items-start">
                                                    <div class="cr-card-title">@nombre</div>
                                                    <span class="badge @(p.EsGrupal ? "bg-info text-dark" : "bg-secondary")">
                                                        @(p.EsGrupal ? $"Grupal x{p.CantidadUsuarios}" : "Individual")
                                                    </span>
                                                </div>
                                                <div class="cr-card-subtitle mt-2">
                                                    <div>@p.CantDias</div>
                                                    <div>@p.CantLeccionesPorUsuario lecciones por usuario</div>
                                                </div>
                                                <div class="cr-card-price">₡@p.PagoPorUsuario.ToString("N2")</div>
                                                <div class="mt-2">
                                                    <span class="badge @(p.Activo ? "bg-success" : "bg-secondary")">@(p.Activo ? "Visible" : "Oculto")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>

                        <nav class="mt-4" aria-label="Paginación">
                            <ul class="pagination justify-content-center">
                                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex - 1)" asp-route-buscar="@currentBuscar" asp-route-soloActivos="@currentSoloActivos">Anterior</a>
                                </li>
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                        <a class="page-link" asp-action="Index" asp-route-pageNumber="@i" asp-route-buscar="@currentBuscar" asp-route-soloActivos="@currentSoloActivos">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(Model.PageIndex + 1)" asp-route-buscar="@currentBuscar" asp-route-soloActivos="@currentSoloActivos">Siguiente</a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
