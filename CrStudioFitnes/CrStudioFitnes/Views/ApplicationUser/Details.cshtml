@model CrStudioFitnes.Models.ApplicationUser
@using CrStudioFitnes.Models

@{
    ViewData["Title"] = "Detalles de usuario";

    var nombreCompleto = $"{Model.Nombre} {Model.Apellidos}".Trim();
    if (string.IsNullOrWhiteSpace(nombreCompleto)) { nombreCompleto = "Usuario"; }

    var nowUtc = DateTimeOffset.UtcNow;
    bool activo = (Model.LockoutEnd == null || Model.LockoutEnd <= nowUtc);

    var hoy = DateTime.Today;

    var paqueteActual = (Model.PaquetesUsuario ?? new List<PaqueteUsuario>())
        .Where(pu => pu.FechaInicio.Date <= hoy && pu.FechaFin.Date >= hoy)
        .OrderByDescending(pu => pu.FechaFin)
        .FirstOrDefault();

    paqueteActual ??= (Model.PaquetesUsuario ?? new List<PaqueteUsuario>())
        .OrderByDescending(pu => pu.FechaFin)
        .FirstOrDefault();

    var paquetesDisponibles = ViewBag.PaquetesDisponibles as List<Paquete>;

    var tiposPlanFiltro = (paquetesDisponibles ?? new List<Paquete>())
    .Select(p => p.CantDias)
    .Distinct()
    .OrderBy(x => x)
    .ToList();

    var leccionesFiltro = (paquetesDisponibles ?? new List<Paquete>())
        .Select(p => p.CantLecciones)
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    // ==========================
    // Permisos (según controller)
    // ==========================
    bool isAdmin = User.IsInRole("Administrador");

    bool canCambiarEstado = isAdmin; // Activar/Desactivar
    bool canGestionarRoles = isAdmin; // GestionarRoles

    bool canCambiarPaquete =
        User.IsInRole("Gestor de Pagos") || User.IsInRole("Administrador") || User.IsInRole("Entrenador");

    bool canPagarPaquete =
        User.IsInRole("Gestor de Pagos") || User.IsInRole("Administrador");

    bool canVerHistorialPagos =
        User.IsInRole("Gestor de Pagos") || User.IsInRole("Administrador");

    bool canConfigurarFamiliar =
     User.IsInRole("Administrador");
}

@if (TempData["OkEstado"] != null)
{
    <div class="alert alert-success">@TempData["OkEstado"]</div>
}
@if (TempData["ErrorEstado"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorEstado"]</div>
}
@if (TempData["ErrorRoles"] != null)
{
    <div class="alert alert-danger mt-2">@TempData["ErrorRoles"]</div>
}
@if (TempData["OkRoles"] != null)
{
    <div class="alert alert-info mt-2">@TempData["OkRoles"]</div>
}
@if (TempData["OkFamiliar"] != null)
{
    <div class="alert alert-success mt-2">@TempData["OkFamiliar"]</div>
}
@if (TempData["ErrorFamiliar"] != null)
{
    <div class="alert alert-danger mt-2">@TempData["ErrorFamiliar"]</div>
}
@if (TempData["OkPago"] != null)
{
    <div class="alert alert-success">@TempData["OkPago"]</div>
}
@if (TempData["ErrorPago"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorPago"]</div>
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">

                    <div class="text-center mb-3">
                        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                        <p class="text-muted mb-0">Datos del cliente y su paquete.</p>
                    </div>

                    @if (TempData["OkPaquete"] != null)
                    {
                        <div class="alert alert-success">@TempData["OkPaquete"]</div>
                    }
                    @if (TempData["ErrorPaquete"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ErrorPaquete"]</div>
                    }

                    <div class="row g-4">
                        <!-- Datos del cliente -->
                        <div class="col-md-6">
                            <h5 class="mb-3">Datos del cliente</h5>

                            <div class="mb-2">
                                <div class="text-muted" style="font-size:.9rem;">Nombre</div>
                                <div class="fw-semibold">@nombreCompleto</div>
                            </div>

                            <div class="mb-2">
                                <div class="text-muted" style="font-size:.9rem;">Cédula</div>
                                <div class="fw-semibold">@Model.Cedula</div>
                            </div>

                            <div class="mb-2">
                                <div class="text-muted" style="font-size:.9rem;">Email</div>
                                <div class="fw-semibold">@Model.Email</div>
                            </div>

                            <div class="mb-2">
                                <div class="text-muted" style="font-size:.9rem;">Teléfono personal</div>
                                <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(Model.TelefonoPersonal) ? Model.TelefonoPersonal : "—")</div>
                            </div>

                            <div class="mb-2">
                                <div class="text-muted" style="font-size:.9rem;">Teléfono emergencia</div>
                                <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(Model.TelefonoEmergencia) ? Model.TelefonoEmergencia : "—")</div>
                            </div>

                            <div class="mb-2">
                                <div class="text-muted" style="font-size:.9rem;">Lesión u operación</div>
                                <div class="fw-semibold">
                                    @(!string.IsNullOrWhiteSpace(Model.LesionOperacion) ? Model.LesionOperacion : "—")
                                </div>
                            </div>

                            <div class="mb-2">
                                <div class="text-muted" style="font-size:.9rem;">Patología</div>
                                <div class="fw-semibold">
                                    @(!string.IsNullOrWhiteSpace(Model.Patologia) ? Model.Patologia : "—")
                                </div>
                            </div>

                            @if (canConfigurarFamiliar)
                            {
                                <form asp-action="ActualizarFamiliar" method="post" class="mt-3">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="idUsuario" value="@Model.Id" />

                                    <div class="mb-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <label class="text-muted mb-0" style="font-size:.9rem;" for="familiar">
                                                Familiar
                                            </label>

                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       role="switch"
                                                       id="familiar"
                                                       name="familiar"
                                                       value="true"
                                                @(Model.Familiar ? "checked" : "") />

                                                <input type="hidden" name="familiar" value="false" />
                                            </div>

                                            <span class="fw-semibold">
                                                @(Model.Familiar ? "Sí" : "No")
                                            </span>
                                        </div>
                                    </div>

                                    <div class="d-flex align-items-end justify-content-between mt-3 gap-2 flex-wrap">
                                        <div style="max-width: 180px;">
                                            <label for="cantidadFamilia" class="form-label text-muted mb-1" style="font-size:.9rem;">
                                                Cantidad familiar
                                            </label>

                                            <input type="number"
                                                   class="form-control"
                                                   id="cantidadFamilia"
                                                   name="cantidadFamilia"
                                                   min="0"
                                                   value="@(Model.CantidadFamilia.HasValue ? Model.CantidadFamilia.Value.ToString() : "")" />
                                        </div>

                                        <button type="submit" class="btn btn-outline-primary cr-btn-mini">
                                            Guardar
                                        </button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <div class="mb-2">
                                    <div class="text-muted" style="font-size:.9rem;">Familiar</div>
                                    <div class="fw-semibold">@(Model.Familiar ? "Sí" : "No")</div>
                                </div>

                                <div class="mb-2">
                                    <div class="text-muted" style="font-size:.9rem;">Cantidad familiar</div>
                                    <div class="fw-semibold">
                                        @(Model.CantidadFamilia.HasValue ? Model.CantidadFamilia.Value.ToString() : "—")
                                    </div>
                                </div>
                            }

                            <div class="d-flex align-items-center justify-content-between mt-3 gap-2 flex-wrap">
                                <div class="cr-status @(activo ? "cr-status--ok" : "cr-status--off")">
                                    <span class="cr-dot"></span>
                                    <span class="cr-status-text">@(activo ? "Activo" : "Inactivo")</span>
                                </div>

                                @* Activar/Desactivar: solo Admin *@
                                @if (canCambiarEstado)
                                {
                                    if (activo)
                                    {
                                        <form asp-action="Desactivar" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idUsuario" value="@Model.Id" />
                                            <button type="submit" class="btn btn-outline-danger cr-btn-mini">
                                                Desactivar
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activar" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idUsuario" value="@Model.Id" />
                                            <button type="submit" class="btn btn-outline-success cr-btn-mini">
                                                Activar
                                            </button>
                                        </form>
                                    }
                                }
                            </div>

                            @* Gestionar roles: solo Admin *@
                            @if (canGestionarRoles)
                            {
                                <button type="button" class="btn btn-outline-primary mt-2" data-bs-toggle="modal" data-bs-target="#rolesModal">
                                    Gestionar roles
                                </button>
                            }
                        </div>

                        <!-- Paquete -->
                        <div class="col-md-6">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <h5 class="mb-0">Paquete</h5>
                                <span class="text-muted" style="font-size:.9rem;">Hoy: @hoy.ToString("dd/MM/yyyy")</span>
                            </div>

                            @if (paqueteActual == null)
                            {
                                <div class="alert alert-info">
                                    Este usuario no tiene un paquete asignado actualmente.
                                </div>

                                @* Agregar/Cambiar paquete: GestorPagos/Admin/Entrenador *@
                                @if (canCambiarPaquete)
                                {
                                    <button type="button" class="btn btn-primary w-100"
                                            data-bs-toggle="modal" data-bs-target="#modalPaquete">
                                        Agregar paquete
                                    </button>
                                }
                            }
                            else
                            {
                                var vigente = (paqueteActual.FechaInicio.Date <= hoy && paqueteActual.FechaFin.Date >= hoy);

                                <div class="cr-card-paquete mb-3">
                                    <div class="cr-card-paquete-body">
                                        <div class="cr-card-title">Paquete #@paqueteActual.IdPaquete</div>

                                        <div class="cr-card-subtitle">
                                            <div>Plan: @paqueteActual.Paquete?.CantDias</div>
                                            <div>
                                                <span class="text-muted">Pago total:</span>
                                                <span class="fw-semibold">@((paqueteActual.Paquete?.Pago ?? 0).ToString("N2"))</span>
                                            </div>
                                            <div>
                                                <span class="text-muted">Pago por usuario:</span>
                                                <span class="fw-semibold">@((paqueteActual.Paquete?.PagoPorUsuario ?? 0).ToString("N2"))</span>
                                            </div>
                                            <div>
                                                <span class="text-muted">Lecciones totales:</span>
                                                <span class="fw-semibold">@paqueteActual.Paquete?.CantLecciones</span>
                                            </div>
                                            <div>
                                                <span class="text-muted">Lecciones por usuario:</span>
                                                <span class="fw-semibold">@paqueteActual.Paquete?.CantLeccionesPorUsuario</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(paqueteActual.Paquete?.Detalle))
                                            {
                                                <div class="text-muted mt-1">@paqueteActual.Paquete.Detalle</div>
                                            }
                                        </div>

                                        <div class="mt-3" style="font-size:.95rem;">
                                            <div>
                                                <span class="text-muted">Lecciones del usuario:</span>
                                                <span class="fw-semibold">@paqueteActual.CantLecciones</span>
                                            </div>
                                            <div>
                                                <span class="text-muted">Inicio:</span>
                                                <span class="fw-semibold">@paqueteActual.FechaInicio.ToString("dd/MM/yyyy")</span>
                                            </div>
                                            <div>
                                                <span class="text-muted">Fin:</span>
                                                <span class="fw-semibold">@paqueteActual.FechaFin.ToString("dd/MM/yyyy")</span>
                                            </div>
                                        </div>

                                        <div class="mt-3">
                                            @if (vigente)
                                            {
                                                <span class="badge bg-success">Vigente</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">No vigente</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                @* Pagar paquete: GestorPagos/Admin *@
                                @if (canPagarPaquete)
                                {
                                    <button type="button"
                                            class="btn btn-outline-success w-100"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalPagarPaquete">
                                        Pagar paquete
                                    </button>
                                }

                                @* Cambiar paquete: GestorPagos/Admin/Entrenador *@
                                @if (canCambiarPaquete)
                                {
                                    <button type="button" class="btn btn-outline-primary w-100 mt-2"
                                            data-bs-toggle="modal" data-bs-target="#modalPaquete">
                                        Cambiar paquete
                                    </button>
                                }

                                @* Historial de pagos: GestorPagos/Admin/Entrenador/Usuario *@
                                @if (canVerHistorialPagos)
                                {
                                    <a asp-action="HistorialPagos" asp-route-id="@Model.Id" class="btn btn-outline-secondary w-100 mt-2">
                                        Historial de pagos
                                    </a>
                                }
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@* ==========================
   MODAL PAGAR PAQUETE
   ========================== *@
@if (canPagarPaquete && paqueteActual != null)
{
    var montoPaqueteActual = (paqueteActual.Paquete?.PagoPorUsuario ?? 0) > 0
        ? paqueteActual.Paquete!.PagoPorUsuario
        : paqueteActual.Paquete?.Pago ?? 0;

    var leccionesPaqueteActual = (paqueteActual.Paquete?.CantLeccionesPorUsuario ?? 0) > 0
        ? paqueteActual.Paquete!.CantLeccionesPorUsuario
        : paqueteActual.Paquete?.CantLecciones ?? 0;

    <div class="modal fade" id="modalPagarPaquete" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content cr-card">
                <div class="modal-header">
                    <h5 class="modal-title">Pagar paquete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <form asp-action="PagarPaquete" method="post">
                    @Html.AntiForgeryToken()

                    <div class="modal-body">
                        <input type="hidden" name="idUsuario" value="@Model.Id" />

                        <p class="text-muted mb-3">
                            Registrar pago para <strong>@nombreCompleto</strong>.
                        </p>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <div class="text-muted" style="font-size:.9rem;">Monto por usuario</div>
                                <div class="fw-semibold">@montoPaqueteActual.ToString("N2")</div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <div class="text-muted" style="font-size:.9rem;">Lecciones por usuario</div>
                                <div class="fw-semibold">@leccionesPaqueteActual</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="tipoPago" class="form-label">Tipo de pago</label>
                            <select id="tipoPago" name="tipoPago" class="form-select" required>
                                <option value="CONTADO">Contado</option>
                                <option value="CREDITO">Crédito</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="fechaPago" class="form-label">Fecha de pago</label>
                            <input type="date"
                                   id="fechaPago"
                                   name="fechaPago"
                                   class="form-control"
                                   value="@hoy.ToString("yyyy-MM-dd")"
                                   required />
                        </div>

                        <div class="alert alert-info mb-0" style="font-size:.9rem;">
                            <strong>Contado:</strong> el pago queda en 0 y se registra un abono por el total del paquete.
                            <br />
                            <strong>Crédito:</strong> el pago queda con el monto original y no se registra abono.
                        </div>
                    </div>

                    <div class="modal-footer d-flex gap-2">
                        <button type="submit" class="btn btn-success w-100">
                            Confirmar pago
                        </button>

                        <button type="button" class="btn btn-outline-secondary w-100" data-bs-dismiss="modal">
                            Cancelar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
@* ==========================
   MODAL PAQUETE (solo si puede)
   ========================== *@
@if (canCambiarPaquete)
{
    <div class="modal fade" id="modalPaquete" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content cr-card">
                <div class="modal-header">
                    <h5 class="modal-title">Seleccionar paquete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <form asp-action="CambiarPaquete" method="post">
                    @Html.AntiForgeryToken()

                    <div class="modal-body">
                        <input type="hidden" name="idUsuario" value="@Model.Id" />
                        <input type="hidden" name="idPaquete" id="idPaqueteSeleccionado" value="" />

                        <p class="text-muted mb-3">
                            Seleccioná un paquete para <strong>@nombreCompleto</strong>.
                        </p>

                        @if (paquetesDisponibles == null || !paquetesDisponibles.Any())
                        {
                            <div class="alert alert-info mb-0">
                                No hay paquetes activos disponibles.
                            </div>
                        }
                        else
                        {
                            <div class="row g-2 mb-3">
                                <div class="col-12 col-md-5">
                                    <label for="filtroTipoPlanPaquete" class="form-label text-muted mb-1" style="font-size:.9rem;">
                                        Tipo plan
                                    </label>

                                    <select id="filtroTipoPlanPaquete" class="form-select form-select-sm">
                                        <option value="">Todos</option>
                                        @foreach (var plan in tiposPlanFiltro)
                                        {
                                            <option value="@plan">@plan</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-12 col-md-5">
                                    <label for="filtroLeccionesPaquete" class="form-label text-muted mb-1" style="font-size:.9rem;">
                                        Cantidad de lecciones
                                    </label>

                                    <select id="filtroLeccionesPaquete" class="form-select form-select-sm">
                                        <option value="">Todas</option>
                                        @foreach (var cant in leccionesFiltro)
                                        {
                                            <option value="@cant">@cant</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-12 col-md-2 d-flex align-items-end">
                                    <button type="button" class="btn btn-outline-secondary btn-sm w-100" id="btnLimpiarFiltrosPaquete">
                                        Limpiar
                                    </button>
                                </div>
                            </div>

                            <div class="alert alert-info d-none" id="sinResultadosPaquetes">
                                No hay paquetes que coincidan con los filtros seleccionados.
                            </div>

                            <div class="row g-3" id="contenedorPaquetes">
                                @foreach (var p in paquetesDisponibles)
                                {
                                    var isCurrent = paqueteActual != null && paqueteActual.IdPaquete == p.IdPaquete;

                                    <div class="col-12 col-md-6 paquete-item"
                                         data-plan="@p.CantDias"
                                         data-lecciones="@p.CantLecciones">
                                        <div class="cr-card-paquete paquete-select-card h-100 @(isCurrent ? "selected" : "")"
                                             data-id="@p.IdPaquete"
                                             style="cursor:pointer;">
                                            <div class="cr-card-paquete-body">
                                                <div class="cr-card-title">Paquete #@p.IdPaquete</div>
                                                <div class="cr-card-subtitle">
                                                    <div>Plan: <span class="fw-semibold">@p.CantDias</span></div>
                                                    <div>Lecciones: <span class="fw-semibold">@p.CantLecciones</span></div>
                                                    <div>Pago: <span class="fw-semibold">@p.Pago.ToString("N2")</span></div>
                                                    @if (!string.IsNullOrWhiteSpace(p.Detalle))
                                                    {
                                                        <div class="text-muted mt-1">@p.Detalle</div>
                                                    }
                                                </div>
                                                @if (isCurrent)
                                                {
                                                    <div class="mt-2">
                                                        <span class="badge bg-info">Actual</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="modal-footer d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100" id="btnGuardarPaquete">
                            Guardar
                        </button>
                        <button type="button" class="btn btn-outline-secondary w-100" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* ==========================
   MODAL ROLES (solo Admin)
   ========================== *@
@if (canGestionarRoles)
{
    var rolesUsuario = ViewBag.RolesUsuario as List<string> ?? new List<string>();
    var rolesNoTiene = ViewBag.RolesNoTiene as List<string> ?? new List<string>();

    <div class="modal fade" id="rolesModal" tabindex="-1" aria-labelledby="rolesModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content cr-card">
                <div class="modal-header">
                    <h5 class="modal-title" id="rolesModalLabel">Gestionar roles</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <form method="post" asp-action="GestionarRoles">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idUsuario" value="@Model.Id" />

                    <input type="hidden" name="addRole" id="addRole" />
                    <input type="hidden" name="removeRole" id="removeRole" />

                    <div class="modal-body">
                        <div class="text-muted small mb-3 text-center">
                            Elegí un rol para <strong>quitar</strong> o un rol para <strong>agregar</strong>. Solo uno a la vez.
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Roles que TIENE (quitar)</label>
                                <select id="selRolesTiene" class="form-select">
                                    <option value="">-- Seleccionar --</option>
                                    @foreach (var r in rolesUsuario)
                                    {
                                        <option value="@r">@r</option>
                                    }
                                </select>
                                @if (rolesUsuario.Count == 0)
                                {
                                    <div class="text-muted small mt-1">(no tiene roles)</div>
                                }
                            </div>

                            <div class="col-12 col-md-6">
                                <label class="form-label fw-semibold">Roles que NO tiene (agregar)</label>
                                <select id="selRolesNoTiene" class="form-select">
                                    <option value="">-- Seleccionar --</option>
                                    @foreach (var r in rolesNoTiene)
                                    {
                                        <option value="@r">@r</option>
                                    }
                                </select>
                                @if (rolesNoTiene.Count == 0)
                                {
                                    <div class="text-muted small mt-1">(no hay roles disponibles)</div>
                                }
                            </div>
                        </div>

                        <div class="text-center small mt-3" id="rolesAccionTxt"></div>
                    </div>

                    <div class="modal-footer d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100" id="btnAplicarRol" disabled>
                            Aplicar cambio
                        </button>
                        <button type="button" class="btn btn-outline-secondary w-100" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<style>
    .paquete-select-card.selected {
        outline: 2px solid rgba(255,255,255,.35);
        box-shadow: 0 0 0 3px rgba(0,0,0,.2);
    }

    .cr-status {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .35rem .75rem;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.18);
        background: rgba(255,255,255,.06);
        font-size: .95rem;
        font-weight: 600;
    }

    .cr-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        display: inline-block;
        background: rgba(255,255,255,.45);
        box-shadow: 0 0 0 4px rgba(255,255,255,.06);
    }

    .cr-status--ok .cr-dot {
        background: #22c55e;
        box-shadow: 0 0 0 4px rgba(34,197,94,.18);
    }

    .cr-status--off .cr-dot {
        background: #94a3b8;
        box-shadow: 0 0 0 4px rgba(148,163,184,.18);
    }

    .cr-status-text {
        line-height: 1;
    }

    .cr-btn-mini {
        padding: .45rem .9rem;
        font-size: .95rem;
        border-radius: .4rem;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // ====== Selección y filtros de paquete ======
            const cards = document.querySelectorAll('.paquete-select-card');
            const inputId = document.getElementById('idPaqueteSeleccionado');

            const filtroTipoPlan = document.getElementById('filtroTipoPlanPaquete');
            const filtroLecciones = document.getElementById('filtroLeccionesPaquete');
            const btnLimpiarFiltros = document.getElementById('btnLimpiarFiltrosPaquete');
            const itemsPaquete = document.querySelectorAll('.paquete-item');
            const sinResultadosPaquetes = document.getElementById('sinResultadosPaquetes');

            if (cards && cards.length && inputId) {
                cards.forEach(c => {
                    c.addEventListener('click', () => {
                        cards.forEach(x => x.classList.remove('selected'));
                        c.classList.add('selected');
                        inputId.value = c.getAttribute('data-id') || '';
                    });
                });
            }

            function aplicarFiltrosPaquetes() {
                const plan = filtroTipoPlan ? filtroTipoPlan.value : '';
                const lecciones = filtroLecciones ? filtroLecciones.value : '';

                let visibles = 0;

                itemsPaquete.forEach(item => {
                    const itemPlan = item.getAttribute('data-plan') || '';
                    const itemLecciones = item.getAttribute('data-lecciones') || '';

                    const cumplePlan = !plan || itemPlan === plan;
                    const cumpleLecciones = !lecciones || itemLecciones === lecciones;

                    const visible = cumplePlan && cumpleLecciones;

                    item.classList.toggle('d-none', !visible);

                    if (visible) {
                        visibles++;
                    }
                });

                if (sinResultadosPaquetes) {
                    sinResultadosPaquetes.classList.toggle('d-none', visibles > 0);
                }

                // Si el paquete seleccionado queda oculto por el filtro, se limpia la selección
                const seleccionado = document.querySelector('.paquete-select-card.selected');
                if (seleccionado) {
                    const itemSeleccionado = seleccionado.closest('.paquete-item');

                    if (itemSeleccionado && itemSeleccionado.classList.contains('d-none')) {
                        seleccionado.classList.remove('selected');

                        if (inputId) {
                            inputId.value = '';
                        }
                    }
                }
            }

            if (filtroTipoPlan) {
                filtroTipoPlan.addEventListener('change', aplicarFiltrosPaquetes);
            }

            if (filtroLecciones) {
                filtroLecciones.addEventListener('change', aplicarFiltrosPaquetes);
            }

            if (btnLimpiarFiltros) {
                btnLimpiarFiltros.addEventListener('click', () => {
                    if (filtroTipoPlan) filtroTipoPlan.value = '';
                    if (filtroLecciones) filtroLecciones.value = '';

                    aplicarFiltrosPaquetes();
                });
            }

            // ====== Gestionar roles (solo si existe el modal) ======
            const selTiene = document.getElementById('selRolesTiene');
            const selNoTiene = document.getElementById('selRolesNoTiene');

            const inputAdd = document.getElementById('addRole');
            const inputRemove = document.getElementById('removeRole');

            const btn = document.getElementById('btnAplicarRol');
            const txt = document.getElementById('rolesAccionTxt');

            function resetHidden() {
                if (inputAdd) inputAdd.value = '';
                if (inputRemove) inputRemove.value = '';
                if (btn) btn.disabled = true;
                if (txt) txt.textContent = '';
            }

            if (selTiene && selNoTiene && inputAdd && inputRemove && btn && txt) {
                resetHidden();

                selTiene.addEventListener('change', () => {
                    const val = selTiene.value || '';
                    selNoTiene.value = '';

                    inputAdd.value = '';
                    inputRemove.value = val;

                    if (val) {
                        btn.disabled = false;
                        txt.textContent = 'Se quitará el rol: ' + val;
                    } else {
                        resetHidden();
                    }
                });

                selNoTiene.addEventListener('change', () => {
                    const val = selNoTiene.value || '';
                    selTiene.value = '';

                    inputRemove.value = '';
                    inputAdd.value = val;

                    if (val) {
                        btn.disabled = false;
                        txt.textContent = 'Se agregará el rol: ' + val;
                    } else {
                        resetHidden();
                    }
                });
            }
        });
    </script>
}
