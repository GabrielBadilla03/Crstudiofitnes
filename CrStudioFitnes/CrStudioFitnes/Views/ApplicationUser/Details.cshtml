@model CrStudioFitnes.Models.ApplicationUser
@using CrStudioFitnes.Models
@using CrStudioFitnes.ViewModels

@{
    ViewData["Title"] = "Detalles de usuario";

    var nombreCompleto = $"{Model.Nombre} {Model.Apellidos}".Trim();
    if (string.IsNullOrWhiteSpace(nombreCompleto)) nombreCompleto = "Usuario";

    var nowUtc = DateTimeOffset.UtcNow;
    bool activo = Model.LockoutEnd == null || Model.LockoutEnd <= nowUtc;
    var hoy = DateTime.Today;

    var grupoActual = ViewBag.GrupoActual as GrupoPaqueteDetalleVM;
    var paquetesDisponibles = ViewBag.PaquetesDisponibles as List<Paquete> ?? new List<Paquete>();
    var paquetesGrupoCompatibles = ViewBag.PaquetesGrupalesCompatibles as List<Paquete> ?? new List<Paquete>();

    // Filtros del selector de paquetes.
    // En paquetes grupales se filtra por las lecciones OPERATIVAS de cada usuario,
    // no por el total de referencia del grupo.
    var tiposPlanFiltro = paquetesDisponibles
        .Select(p => p.CantDias)
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    var leccionesFiltro = paquetesDisponibles
        .Select(p => p.CantLeccionesPorUsuario)
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    PaqueteUsuario? paqueteActual = null;
    if (grupoActual != null)
    {
        var miembroActual = grupoActual.Miembros.FirstOrDefault(m => m.IdUsuario == Model.Id);
        if (miembroActual?.IdPaqueteUsuario != null)
        {
            paqueteActual = (Model.PaquetesUsuario ?? new List<PaqueteUsuario>())
                .FirstOrDefault(pu => pu.IdPaqueteUsuario == miembroActual.IdPaqueteUsuario);
        }
    }

    paqueteActual ??= (Model.PaquetesUsuario ?? new List<PaqueteUsuario>())
        .Where(pu => pu.Activo)
        .Where(pu => pu.FechaInicio.Date <= hoy && pu.FechaFin.Date >= hoy)
        .OrderByDescending(pu => pu.IdPaqueteUsuario)
        .FirstOrDefault();

    paqueteActual ??= (Model.PaquetesUsuario ?? new List<PaqueteUsuario>())
        .Where(pu => pu.Activo)
        .OrderByDescending(pu => pu.IdPaqueteUsuario)
        .FirstOrDefault();

    bool isAdmin = User.IsInRole("Administrador");
    bool canCambiarEstado = isAdmin;
    bool canGestionarRoles = isAdmin;
    bool canCambiarPaquete = User.IsInRole("Gestor de Pagos") || isAdmin || User.IsInRole("Entrenador");
    bool canPagarPaquete = User.IsInRole("Gestor de Pagos") || isAdmin;
    bool canVerHistorialPagos = User.IsInRole("Gestor de Pagos") || isAdmin;
    bool canConfigurarFamiliar = isAdmin;

    var rolesUsuario = ViewBag.RolesUsuario as List<string> ?? new List<string>();
    var rolesNoTiene = ViewBag.RolesNoTiene as List<string> ?? new List<string>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-11">
            @foreach (var key in new[] { "OkEstado", "OkRoles", "OkFamiliar", "OkPago", "OkPaquete", "OkGrupo" })
            {
                if (TempData[key] != null)
                {
                    <div class="alert alert-success">@TempData[key]</div>
                }
            }
            @foreach (var key in new[] { "ErrorEstado", "ErrorRoles", "ErrorFamiliar", "ErrorPago", "ErrorPaquete", "ErrorGrupo" })
            {
                if (TempData[key] != null)
                {
                    <div class="alert alert-danger">@TempData[key]</div>
                }
            }

            <div class="card shadow-sm cr-card">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
                        <p class="text-muted mb-0">Datos del cliente, paquete y grupo.</p>
                    </div>

                    <div class="row g-4">
                        <div class="col-lg-5">
                            <h5 class="mb-3">Datos del cliente</h5>

                            <div class="cr-info-grid">
                                <div><span>Nombre</span><strong>@nombreCompleto</strong></div>
                                <div><span>Cédula</span><strong>@Model.Cedula</strong></div>
                                <div><span>Email</span><strong>@Model.Email</strong></div>
                                <div><span>Teléfono</span><strong>@(Model.TelefonoPersonal ?? "—")</strong></div>
                                <div><span>Emergencia</span><strong>@(Model.TelefonoEmergencia ?? "—")</strong></div>
                                <div><span>Lesión/operación</span><strong>@(Model.LesionOperacion ?? "—")</strong></div>
                                <div><span>Patología</span><strong>@(Model.Patologia ?? "—")</strong></div>
                            </div>

                            @if (canConfigurarFamiliar)
                            {
                                <form asp-action="ActualizarFamiliar" method="post" class="border rounded p-3 mt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idUsuario" value="@Model.Id" />
                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" id="familiar" name="familiar" value="true" @(Model.Familiar ? "checked" : "") />
                                        <input type="hidden" name="familiar" value="false" />
                                        <label class="form-check-label" for="familiar">Usuario familiar</label>
                                    </div>
                                    <div class="d-flex gap-2 align-items-end">
                                        <div class="flex-grow-1">
                                            <label class="form-label" for="cantidadFamilia">Cantidad familiar</label>
                                            <input class="form-control" type="number" min="2" max="6" id="cantidadFamilia" name="cantidadFamilia" value="@Model.CantidadFamilia" />
                                        </div>
                                        <button class="btn btn-outline-primary" type="submit">Guardar</button>
                                    </div>
                                </form>
                            }

                            <div class="d-flex align-items-center justify-content-between mt-3 gap-2 flex-wrap">
                                <div>
                                    @if (activo)
                                    {
                                        <span class="badge bg-success">Usuario activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Usuario inactivo</span>
                                    }
                                </div>

                                @if (canCambiarEstado)
                                {
                                    <form asp-action="@(activo ? "Desactivar" : "Activar")" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idUsuario" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm @(activo ? "btn-outline-danger" : "btn-outline-success")">
                                            @(activo ? "Desactivar" : "Activar")
                                        </button>
                                    </form>
                                }
                            </div>

                            @if (canGestionarRoles)
                            {
                                <button type="button" class="btn btn-outline-primary w-100 mt-3" data-bs-toggle="modal" data-bs-target="#rolesModal">
                                    Gestionar roles
                                </button>
                            }
                        </div>

                        <div class="col-lg-7">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0">Paquete</h5>
                                <span class="text-muted small">Hoy: @hoy.ToString("dd/MM/yyyy")</span>
                            </div>

                            @if (paqueteActual == null)
                            {
                                <div class="alert alert-info">Este usuario no tiene un paquete activo asignado.</div>
                            }
                            else
                            {
                                var p = paqueteActual.Paquete;
                                bool vigente = paqueteActual.FechaInicio.Date <= hoy && paqueteActual.FechaFin.Date >= hoy;
                                <div class="cr-card-paquete mb-3">
                                    <div class="cr-card-paquete-body">
                                        <div class="d-flex justify-content-between gap-2 flex-wrap">
                                            <div>
                                                <div class="cr-card-title">@(string.IsNullOrWhiteSpace(p?.Detalle) ? $"Paquete #{paqueteActual.IdPaquete}" : p!.Detalle)</div>
                                                <div class="cr-card-subtitle">Plan: @p?.CantDias</div>
                                            </div>
                                            <div>
                                                @if (grupoActual != null)
                                                {
                                                    <span class="badge bg-info text-dark">Grupal · @grupoActual.CantidadUsuarios usuarios</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Individual</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="row g-2 mt-2">
                                            <div class="col-6"><span class="text-muted">Lecciones por usuario:</span><div class="fw-semibold">@(p?.CantLeccionesPorUsuario ?? 0)</div></div>
                                            <div class="col-6"><span class="text-muted">Monto por usuario:</span><div class="fw-semibold">₡@((p?.PagoPorUsuario ?? 0).ToString("N2"))</div></div>
                                            <div class="col-6"><span class="text-muted">Lecciones disponibles:</span><div class="fw-semibold">@paqueteActual.CantLecciones</div></div>
                                            <div class="col-6"><span class="text-muted">Estado:</span><div class="fw-semibold">@(vigente ? "Vigente" : "Pendiente / vencido")</div></div>
                                            <div class="col-6"><span class="text-muted">Inicio:</span><div class="fw-semibold">@paqueteActual.FechaInicio.ToString("dd/MM/yyyy")</div></div>
                                            <div class="col-6"><span class="text-muted">Fin:</span><div class="fw-semibold">@paqueteActual.FechaFin.ToString("dd/MM/yyyy")</div></div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (grupoActual != null)
                            {
                                <div class="border rounded p-3 mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
                                        <div>
                                            <div class="fw-semibold">Grupo #@grupoActual.IdGrupoPaquete</div>
                                            <div class="text-muted small">@grupoActual.NombrePaquete</div>
                                        </div>
                                        @if (canCambiarPaquete)
                                        {
                                            <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editarGrupoModal">
                                                Editar grupo
                                            </button>
                                        }
                                    </div>

                                    @if (grupoActual.TieneSaldoPendiente)
                                    {
                                        <div class="alert alert-warning py-2">
                                            <strong>No se puede renovar todavía.</strong> Hay integrantes con saldo pendiente.
                                        </div>
                                    }

                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Integrante</th>
                                                    <th>Cédula</th>
                                                    <th>Lecciones</th>
                                                    <th>Deuda</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var miembro in grupoActual.Miembros)
                                                {
                                                    <tr>
                                                        <td>
                                                            @miembro.NombreCompleto
                                                            @if (miembro.EsUsuarioActual)
                                                            {
                                                                <span class="badge bg-info text-dark ms-1">Actual</span>
                                                            }
                                                        </td>
                                                        <td>@miembro.Cedula</td>
                                                        <td>@miembro.CantLecciones</td>
                                                        <td>
                                                            @if (miembro.SaldoPendiente > 0)
                                                            {
                                                                <span class="text-warning fw-semibold">₡@miembro.SaldoPendiente.ToString("N2")</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-success">Pagado</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            }

                            <div class="d-grid gap-2">
                                @if (canPagarPaquete && paqueteActual != null)
                                {
                                    <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalPagarPaquete">
                                        @(grupoActual != null ? "Pagar / renovar grupo" : "Pagar paquete")
                                    </button>
                                }

                                @if (canCambiarPaquete && grupoActual == null)
                                {
                                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalPaquete">
                                        @(paqueteActual == null ? "Asignar paquete" : "Cambiar paquete")
                                    </button>
                                }

                                @if (canVerHistorialPagos)
                                {
                                    <a asp-action="HistorialPagos" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Historial de pagos</a>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (canPagarPaquete && paqueteActual != null)
{
    var p = paqueteActual.Paquete;
    decimal montoUsuario = p?.PagoPorUsuario ?? 0;
    int leccionesUsuario = p?.CantLeccionesPorUsuario ?? 0;
    decimal totalGrupo = grupoActual != null ? montoUsuario * grupoActual.CantidadUsuarios : montoUsuario;

    <div class="modal fade" id="modalPagarPaquete" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content cr-card">
                <div class="modal-header">
                    <h5 class="modal-title">@(grupoActual != null ? "Pagar / renovar grupo" : "Pagar paquete")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form asp-action="PagarPaquete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idUsuario" value="@Model.Id" />
                    <div class="modal-body">
                        @if (grupoActual != null)
                        {
                            <div class="alert alert-info">
                                Esta operación se aplicará a los <strong>@grupoActual.CantidadUsuarios integrantes</strong> del grupo.
                                Cada uno recibirá <strong>@leccionesUsuario lecciones</strong> y tendrá un pago individual de
                                <strong>₡@montoUsuario.ToString("N2")</strong>.
                                <div class="mt-1">Referencia total: <strong>₡@totalGrupo.ToString("N2")</strong>.</div>
                            </div>

                            @if (grupoActual.TieneSaldoPendiente)
                            {
                                <div class="alert alert-warning">
                                    La renovación será rechazada mientras exista saldo pendiente en cualquiera de los integrantes.
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-info">Se asignarán @leccionesUsuario lecciones por ₡@montoUsuario.ToString("N2").</div>
                        }

                        <div class="mb-3">
                            <label class="form-label" for="tipoPago">Tipo de pago</label>
                            <select class="form-select" id="tipoPago" name="tipoPago" required>
                                <option value="CONTADO">Contado</option>
                                <option value="CREDITO">Crédito</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="fechaPago">Fecha de pago</label>
                            <input class="form-control" type="date" id="fechaPago" name="fechaPago" value="@hoy.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="small text-muted">
                            En crédito, cada integrante recibe su propia deuda. Los abonos posteriores se registran individualmente.
                        </div>
                    </div>
                    <div class="modal-footer d-flex gap-2">
                        <button class="btn btn-success w-100" type="submit">Confirmar</button>
                        <button class="btn btn-outline-secondary w-100" type="button" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (canCambiarPaquete && grupoActual == null)
{
    <div class="modal fade" id="modalPaquete" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content cr-card">
                <div class="modal-header">
                    <h5 class="modal-title">Seleccionar paquete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form asp-action="CambiarPaquete" method="post" id="formAsignarPaquete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idUsuario" value="@Model.Id" />
                    <input type="hidden" name="idPaquete" id="idPaqueteSeleccionado" />
                    <div id="usuariosGrupoHidden"></div>

                    <div class="modal-body">
                        <p class="text-muted">Seleccioná el paquete para <strong>@nombreCompleto</strong>.</p>

                        @if (paquetesDisponibles.Any())
                        {
                            <div class="row g-2 mb-3">
                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label for="filtroTipoPlanPaquete" class="form-label text-muted mb-1 small">
                                        Tipo de plan
                                    </label>
                                    <select id="filtroTipoPlanPaquete" class="form-select form-select-sm">
                                        <option value="">Todos</option>
                                        @foreach (var plan in tiposPlanFiltro)
                                        {
                                            <option value="@plan">@plan</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label for="filtroLeccionesPaquete" class="form-label text-muted mb-1 small">
                                        Lecciones por usuario
                                    </label>
                                    <select id="filtroLeccionesPaquete" class="form-select form-select-sm">
                                        <option value="">Todas</option>
                                        @foreach (var cant in leccionesFiltro)
                                        {
                                            <option value="@cant">@cant</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-12 col-sm-6 col-lg-3">
                                    <label for="filtroTipoPaquete" class="form-label text-muted mb-1 small">
                                        Tipo de paquete
                                    </label>
                                    <select id="filtroTipoPaquete" class="form-select form-select-sm">
                                        <option value="">Todos</option>
                                        <option value="individual">Individual</option>
                                        <option value="grupal">Grupal</option>
                                    </select>
                                </div>

                                <div class="col-12 col-sm-6 col-lg-3 d-flex align-items-end">
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm w-100"
                                            id="btnLimpiarFiltrosPaquete">
                                        Limpiar filtros
                                    </button>
                                </div>
                            </div>

                            <div class="alert alert-info d-none py-2" id="sinResultadosPaquetes">
                                No hay paquetes que coincidan con los filtros seleccionados.
                            </div>
                        }

                        <div class="row g-3" id="contenedorPaquetes">
                            @foreach (var p in paquetesDisponibles)
                            {
                                <div class="col-12 col-md-6 col-xl-4 paquete-item">
                                    <div class="cr-card-paquete paquete-select-card h-100"
                                         role="button"
                                         tabindex="0"
                                         data-id="@p.IdPaquete"
                                         data-plan="@p.CantDias"
                                         data-lecciones="@p.CantLeccionesPorUsuario"
                                         data-esgrupal="@p.EsGrupal.ToString().ToLowerInvariant()"
                                         data-cantidad="@p.CantidadUsuarios"
                                         data-nombre="@(p.Detalle ?? $"Paquete #{p.IdPaquete}")">
                                        <div class="cr-card-paquete-body">
                                            <div class="d-flex justify-content-between gap-2">
                                                <div class="cr-card-title">@(p.Detalle ?? $"Paquete #{p.IdPaquete}")</div>
                                                <span class="badge @(p.EsGrupal ? "bg-info text-dark" : "bg-secondary")">@(p.EsGrupal ? $"Grupal x{p.CantidadUsuarios}" : "Individual")</span>
                                            </div>
                                            <div class="cr-card-subtitle mt-2">
                                                <div>@p.CantDias</div>
                                                <div>@p.CantLeccionesPorUsuario lecciones por usuario</div>
                                                <div>₡@p.PagoPorUsuario.ToString("N2") por usuario</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="border rounded p-3 mt-4 d-none" id="grupoSeleccionWrap">
                            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-2">
                                <div>
                                    <h6 class="mb-0">Completar grupo</h6>
                                    <div class="text-muted small" id="grupoRequerimiento"></div>
                                </div>
                                <span class="badge bg-info text-dark" id="grupoContador">0 / 0</span>
                            </div>

                            <div class="input-group mb-2">
                                <input type="text" class="form-control" id="buscarUsuarioGrupo" placeholder="Buscar por nombre, cédula o correo..." />
                                <button type="button" class="btn btn-outline-primary" id="btnBuscarUsuarioGrupo">Buscar</button>
                            </div>
                            <div id="resultadosUsuarioGrupo" class="mb-3"></div>
                            <div id="usuariosGrupoSeleccionados" class="d-flex flex-wrap gap-2"></div>
                        </div>
                    </div>
                    <div class="modal-footer d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100" id="btnGuardarPaquete">Guardar asignación</button>
                        <button type="button" class="btn btn-outline-secondary w-100" data-bs-dismiss="modal">Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (grupoActual != null && canCambiarPaquete)
{
    <div class="modal fade" id="editarGrupoModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content cr-card">
                <div class="modal-header">
                    <h5 class="modal-title">Editar grupo #@grupoActual.IdGrupoPaquete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (grupoActual.TieneSaldoPendiente)
                    {
                        <div class="alert alert-warning">
                            El grupo tiene deuda activa. No se podrá reemplazar integrantes, cambiar paquete ni deshacer el grupo hasta que todos paguen.
                        </div>
                    }

                    <h6>Reemplazar integrante</h6>
                    <form asp-action="ReemplazarMiembroGrupo" method="post" id="formReemplazarMiembro" class="border rounded p-3 mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idGrupoPaquete" value="@grupoActual.IdGrupoPaquete" />
                        <input type="hidden" name="idUsuarioRetorno" value="@Model.Id" />
                        <input type="hidden" name="idUsuarioEntra" id="idUsuarioEntra" />

                        <div class="mb-3">
                            <label class="form-label">Integrante que sale</label>
                            <select class="form-select" name="idUsuarioSale" required>
                                <option value="">Seleccione...</option>
                                @foreach (var m in grupoActual.Miembros)
                                {
                                    <option value="@m.IdUsuario">@m.NombreCompleto · @m.Cedula</option>
                                }
                            </select>
                        </div>

                        <div class="input-group mb-2">
                            <input type="text" class="form-control" id="buscarReemplazo" placeholder="Buscar nuevo integrante..." />
                            <button type="button" class="btn btn-outline-primary" id="btnBuscarReemplazo">Buscar</button>
                        </div>
                        <div id="resultadosReemplazo" class="mb-2"></div>
                        <div class="small text-muted mb-3" id="reemplazoSeleccionado">No hay usuario nuevo seleccionado.</div>
                        <button class="btn btn-primary" type="submit">Reemplazar integrante</button>
                    </form>

                    <h6>Cambiar paquete del grupo</h6>
                    <form asp-action="CambiarPaqueteGrupo" method="post" class="border rounded p-3 mb-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idGrupoPaquete" value="@grupoActual.IdGrupoPaquete" />
                        <input type="hidden" name="idUsuarioRetorno" value="@Model.Id" />
                        <div class="d-flex gap-2">
                            <select class="form-select" name="idPaqueteNuevo" required>
                                @foreach (var p in paquetesGrupoCompatibles)
                                {
                                    <option value="@p.IdPaquete" selected="@(p.IdPaquete == grupoActual.IdPaquete ? "selected" : null)">
                                        @(p.Detalle ?? $"Paquete #{p.IdPaquete}") · @p.CantLeccionesPorUsuario lecciones · ₡@p.PagoPorUsuario.ToString("N2")
                                    </option>
                                }
                            </select>
                            <button class="btn btn-outline-primary" type="submit">Cambiar</button>
                        </div>
                        <div class="form-text">Solo se permite si nadie tiene deuda ni lecciones disponibles.</div>
                    </form>

                    <h6 class="text-danger">Deshacer grupo</h6>
                    <form asp-action="DeshacerGrupo" method="post" class="border border-danger rounded p-3" onsubmit="return confirm('¿Seguro que desea deshacer el grupo completo? Los integrantes quedarán sin esta asignación grupal activa.');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idGrupoPaquete" value="@grupoActual.IdGrupoPaquete" />
                        <input type="hidden" name="idUsuarioRetorno" value="@Model.Id" />
                        <p class="text-muted small">Los pagos históricos se conservan. Las asignaciones grupales activas se desactivan y las lecciones restantes se ponen en 0.</p>
                        <button class="btn btn-outline-danger" type="submit">Deshacer grupo completo</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@if (canGestionarRoles)
{
    <div class="modal fade" id="rolesModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content cr-card">
                <div class="modal-header">
                    <h5 class="modal-title">Gestionar roles</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form method="post" asp-action="GestionarRoles" id="formRoles">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idUsuario" value="@Model.Id" />
                    <input type="hidden" name="addRole" id="addRole" />
                    <input type="hidden" name="removeRole" id="removeRole" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Quitar rol</label>
                            <select class="form-select" id="selRolesTiene">
                                <option value="">-- Ninguno --</option>
                                @foreach (var r in rolesUsuario)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Agregar rol</label>
                            <select class="form-select" id="selRolesNoTiene">
                                <option value="">-- Ninguno --</option>
                                @foreach (var r in rolesNoTiene)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-primary w-100" type="submit" id="btnAplicarRol" disabled>Aplicar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const buscarUrl = '@Url.Action("BuscarUsuariosGrupo", "ApplicationUser")';
            const usuarioPrincipalId = '@Model.Id';

            // ==============================
            // Asignación de paquete / grupo
            // ==============================
            const cards = document.querySelectorAll('.paquete-select-card');
            const inputPaquete = document.getElementById('idPaqueteSeleccionado');
            const wrapGrupo = document.getElementById('grupoSeleccionWrap');

            const filtroTipoPlan = document.getElementById('filtroTipoPlanPaquete');
            const filtroLecciones = document.getElementById('filtroLeccionesPaquete');
            const filtroTipoPaquete = document.getElementById('filtroTipoPaquete');
            const btnLimpiarFiltros = document.getElementById('btnLimpiarFiltrosPaquete');
            const sinResultadosPaquetes = document.getElementById('sinResultadosPaquetes');
            const requerimiento = document.getElementById('grupoRequerimiento');
            const contador = document.getElementById('grupoContador');
            const hiddenWrap = document.getElementById('usuariosGrupoHidden');
            const seleccionadosWrap = document.getElementById('usuariosGrupoSeleccionados');
            const btnGuardar = document.getElementById('btnGuardarPaquete');
            let requeridosOtros = 0;
            let seleccionados = [];

            function renderSeleccionados() {
                if (!seleccionadosWrap || !hiddenWrap) return;
                seleccionadosWrap.innerHTML = '';
                hiddenWrap.innerHTML = '';

                seleccionados.forEach(u => {
                    const chip = document.createElement('button');
                    chip.type = 'button';
                    chip.className = 'btn btn-sm btn-outline-info';
                    chip.textContent = `${u.nombre} · ${u.cedula} ×`;
                    chip.addEventListener('click', () => {
                        seleccionados = seleccionados.filter(x => x.idUsuario !== u.idUsuario);
                        renderSeleccionados();
                    });
                    seleccionadosWrap.appendChild(chip);

                    const h = document.createElement('input');
                    h.type = 'hidden';
                    h.name = 'idsUsuariosGrupo';
                    h.value = u.idUsuario;
                    hiddenWrap.appendChild(h);
                });

                if (contador) contador.textContent = `${seleccionados.length} / ${requeridosOtros}`;
                if (btnGuardar && requeridosOtros > 0) btnGuardar.disabled = seleccionados.length !== requeridosOtros;
                else if (btnGuardar) btnGuardar.disabled = !inputPaquete?.value;
            }

            function limpiarSeleccionPaquete() {
                cards.forEach(c => c.classList.remove('selected'));

                if (inputPaquete) {
                    inputPaquete.value = '';
                }

                seleccionados = [];
                requeridosOtros = 0;

                if (wrapGrupo) {
                    wrapGrupo.classList.add('d-none');
                }

                if (requerimiento) {
                    requerimiento.textContent = '';
                }

                const resultadosGrupo = document.getElementById('resultadosUsuarioGrupo');
                if (resultadosGrupo) {
                    resultadosGrupo.innerHTML = '';
                }

                renderSeleccionados();
            }

            function aplicarFiltrosPaquetes() {
                const plan = filtroTipoPlan?.value || '';
                const lecciones = filtroLecciones?.value || '';
                const tipo = filtroTipoPaquete?.value || '';

                let visibles = 0;
                let seleccionOculta = false;

                cards.forEach(card => {
                    const item = card.closest('.paquete-item');
                    if (!item) return;

                    const tipoCard = card.dataset.esgrupal === 'true'
                        ? 'grupal'
                        : 'individual';

                    const coincidePlan =
                        !plan || card.dataset.plan === plan;

                    const coincideLecciones =
                        !lecciones || card.dataset.lecciones === lecciones;

                    const coincideTipo =
                        !tipo || tipoCard === tipo;

                    const mostrar =
                        coincidePlan && coincideLecciones && coincideTipo;

                    item.classList.toggle('d-none', !mostrar);

                    if (mostrar) {
                        visibles++;
                    } else if (card.classList.contains('selected')) {
                        seleccionOculta = true;
                    }
                });

                sinResultadosPaquetes?.classList.toggle('d-none', visibles > 0);

                // Si el paquete que estaba seleccionado deja de cumplir los filtros,
                // se limpia también la selección de integrantes del grupo para evitar
                // enviar un paquete oculto por error.
                if (seleccionOculta) {
                    limpiarSeleccionPaquete();
                }
            }

            filtroTipoPlan?.addEventListener('change', aplicarFiltrosPaquetes);
            filtroLecciones?.addEventListener('change', aplicarFiltrosPaquetes);
            filtroTipoPaquete?.addEventListener('change', aplicarFiltrosPaquetes);

            btnLimpiarFiltros?.addEventListener('click', () => {
                if (filtroTipoPlan) filtroTipoPlan.value = '';
                if (filtroLecciones) filtroLecciones.value = '';
                if (filtroTipoPaquete) filtroTipoPaquete.value = '';

                aplicarFiltrosPaquetes();
            });

            function seleccionarCardPaquete(card) {
                cards.forEach(c => c.classList.remove('selected'));
                card.classList.add('selected');

                if (inputPaquete) {
                    inputPaquete.value = card.dataset.id || '';
                }

                const grupal = card.dataset.esgrupal === 'true';
                const cantidad = Number(card.dataset.cantidad || '1');

                seleccionados = [];
                requeridosOtros = grupal
                    ? Math.max(0, cantidad - 1)
                    : 0;

                if (wrapGrupo) {
                    wrapGrupo.classList.toggle('d-none', !grupal);
                }

                if (requerimiento) {
                    requerimiento.textContent = grupal
                        ? `Este paquete requiere ${cantidad} usuarios en total. Seleccioná ${requeridosOtros} usuario(s) adicional(es).`
                        : '';
                }

                renderSeleccionados();
            }

            cards.forEach(card => {
                card.addEventListener('click', () => {
                    seleccionarCardPaquete(card);
                });

                card.addEventListener('keydown', e => {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        seleccionarCardPaquete(card);
                    }
                });
            });

            async function buscarUsuarios(inputId, resultsId, onSelect) {
                const input = document.getElementById(inputId);
                const results = document.getElementById(resultsId);
                if (!input || !results) return;
                const termino = input.value.trim();
                if (termino.length < 2) {
                    results.innerHTML = '<div class="text-warning small">Ingresá al menos 2 caracteres.</div>';
                    return;
                }

                results.innerHTML = '<div class="text-muted small">Buscando...</div>';
                try {
                    const res = await fetch(`${buscarUrl}?termino=${encodeURIComponent(termino)}`);
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.message || 'No se pudo buscar.');

                    results.innerHTML = '';
                    if (!data.usuarios?.length) {
                        results.innerHTML = '<div class="text-muted small">No hay usuarios disponibles.</div>';
                        return;
                    }

                    data.usuarios.forEach(u => {
                        if (u.idUsuario === usuarioPrincipalId) return;
                        const btn = document.createElement('button');
                        btn.type = 'button';
                        btn.className = 'btn btn-outline-secondary btn-sm me-2 mb-2';
                        btn.textContent = `${u.nombre} · ${u.cedula}`;
                        btn.addEventListener('click', () => onSelect(u));
                        results.appendChild(btn);
                    });
                } catch (e) {
                    results.innerHTML = `<div class="text-danger small">${e.message}</div>`;
                }
            }

            document.getElementById('btnBuscarUsuarioGrupo')?.addEventListener('click', () => {
                buscarUsuarios('buscarUsuarioGrupo', 'resultadosUsuarioGrupo', u => {
                    if (seleccionados.some(x => x.idUsuario === u.idUsuario)) return;
                    if (seleccionados.length >= requeridosOtros) return;
                    seleccionados.push(u);
                    renderSeleccionados();
                });
            });

            document.getElementById('formAsignarPaquete')?.addEventListener('submit', e => {
                if (!inputPaquete?.value) {
                    e.preventDefault();
                    alert('Seleccione un paquete.');
                    return;
                }
                if (requeridosOtros > 0 && seleccionados.length !== requeridosOtros) {
                    e.preventDefault();
                    alert(`Debe seleccionar exactamente ${requeridosOtros} usuario(s) adicional(es).`);
                }
            });

            // ==============================
            // Reemplazo de integrante
            // ==============================
            const inputEntra = document.getElementById('idUsuarioEntra');
            const seleccionadoTxt = document.getElementById('reemplazoSeleccionado');
            document.getElementById('btnBuscarReemplazo')?.addEventListener('click', () => {
                buscarUsuarios('buscarReemplazo', 'resultadosReemplazo', u => {
                    if (inputEntra) inputEntra.value = u.idUsuario;
                    if (seleccionadoTxt) seleccionadoTxt.textContent = `Nuevo integrante: ${u.nombre} · ${u.cedula}`;
                });
            });

            document.getElementById('formReemplazarMiembro')?.addEventListener('submit', e => {
                if (!inputEntra?.value) {
                    e.preventDefault();
                    alert('Seleccione el nuevo integrante.');
                }
            });

            // ==============================
            // Roles
            // ==============================
            const selTiene = document.getElementById('selRolesTiene');
            const selNoTiene = document.getElementById('selRolesNoTiene');
            const addRole = document.getElementById('addRole');
            const removeRole = document.getElementById('removeRole');
            const btnRol = document.getElementById('btnAplicarRol');

            function actualizarRoles(origen) {
                if (!addRole || !removeRole || !btnRol) return;
                if (origen === 'quitar') {
                    if (selNoTiene) selNoTiene.value = '';
                    removeRole.value = selTiene?.value || '';
                    addRole.value = '';
                } else {
                    if (selTiene) selTiene.value = '';
                    addRole.value = selNoTiene?.value || '';
                    removeRole.value = '';
                }
                btnRol.disabled = !addRole.value && !removeRole.value;
            }
            selTiene?.addEventListener('change', () => actualizarRoles('quitar'));
            selNoTiene?.addEventListener('change', () => actualizarRoles('agregar'));
        });
    </script>
}

<style>
    .cr-info-grid > div { margin-bottom:.75rem; }
    .cr-info-grid span { display:block; color:var(--muted); font-size:.88rem; }
    .paquete-select-card.selected { outline:2px solid var(--red); box-shadow:0 0 0 3px rgba(254,1,0,.12); }
    .paquete-select-card:focus-visible { outline:2px solid var(--red); outline-offset:2px; }
</style>
