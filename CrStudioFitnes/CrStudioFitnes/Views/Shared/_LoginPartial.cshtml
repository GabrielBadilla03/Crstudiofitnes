@using Microsoft.AspNetCore.Identity
@inject SignInManager<CrStudioFitnes.Models.ApplicationUser> SignInManager
@inject UserManager<CrStudioFitnes.Models.ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a asp-controller="ApplicationUser"
               asp-action="MiPerfil"
               class="nav-link text-dark">
                Mi perfil
            </a>
        </li>

        <li class="nav-item">
            <form class="form-inline"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Reservas", new { area = "" })">

                <button type="submit"
                        class="nav-link btn btn-link text-dark">
                    Cerrar sesión
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-area="Identity"
               asp-page="/Account/Register">
                Registrarse
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link text-dark"
               asp-area="Identity"
               asp-page="/Account/Login">
                Iniciar sesión
            </a>
        </li>
    }
</ul>
